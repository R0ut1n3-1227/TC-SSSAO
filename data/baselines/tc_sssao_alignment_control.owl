  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Sensor">
    <ns1:alignmentRationale xml:lang="en">TC-SSSAO Sensor represents sensing systems used for SSA and is modeled as a domain-specific specialization of sosa:Sensor.</ns1:alignmentRationale>
    <rdfs:label xml:lang="zh">传感器</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdfs:subClassOf rdf:nodeID="N5917bbc4f4ea440aa54a463ec0a4d411"/>
    <rdfs:comment xml:lang="zh">能够探测空间目标的传感器。</rdfs:comment>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <ns1:mappedToExternalTerm rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#reusedOntology">
