  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CollisionRiskEvent">
    <rdfs:comment xml:lang="zh">空间目标之间存在碰撞风险的事件。作为空间关系事件，通过 hasPrimaryObject/hasSecondaryObject 显式表示交会目标角色。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N38abf0feabbb459cb332eeeb47936180"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RiskEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:subClassOf rdf:nodeID="Ne39c643ed8f4405b88c34716e584eabd"/>
    <rdfs:subClassOf rdf:nodeID="N7d79475adf7d484aa26cc5645f227aa1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:label xml:lang="zh">碰撞风险事件</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N33adf386c62241478ff0ebd18a69fd44">
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#updatesState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TrackingSystem">
    <rdfs:label xml:lang="zh">跟踪系统</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdfs:comment xml:lang="zh">用于持续跟踪空间目标的系统。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasArgumentOfPerigee">
    <rdfs:comment xml:lang="zh">轨道近地点幅角。</rdfs:comment>
    <rdfs:label xml:lang="zh">近地点幅角</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TemporalEntity">
