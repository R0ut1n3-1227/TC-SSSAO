    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#TemporalEntity"/>
    <ns1:alignmentRationale xml:lang="en">TC-SSSAO TimeInterval is the application-domain time-interval representation, specialized from time:Interval.</ns1:alignmentRationale>
