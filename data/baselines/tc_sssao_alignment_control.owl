    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Satellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Spacecraft"/>
    <rdfs:label xml:lang="zh">卫星</rdfs:label>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
