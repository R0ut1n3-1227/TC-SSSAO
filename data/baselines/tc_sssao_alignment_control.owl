    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateStartTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N211ae6defc534fce9ff2fe528a5db247">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasThreatID"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SecurityRisk">
    <rdfs:comment xml:lang="zh">空间系统或任务面临损失的潜在可能性。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">安全风险</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N36fb61d8c05b489e9a4aebb98c429d69"/>
    <rdfs:subClassOf rdf:nodeID="N1d4305f8760742df91dc4c7e9b8d3a8c"/>
    <rdfs:subClassOf rdf:nodeID="N8628281a3cc24fc4a77d394309cb57e9"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N87ddaea372864a92b98c78a7ff4c504f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#occursInOrbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#overlapsWithEvent">
    <rdfs:label xml:lang="zh">与事件时间重叠</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <ns1:alignmentRationale xml:lang="en">time:intervalOverlaps relates time intervals; TC-SSSAO overlapsWithEvent relates SpaceEvent instances with overlapping time intervals. Different semantic level: seeAlso only.</ns1:alignmentRationale>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#intervalOverlaps"/>
    <rdfs:comment xml:lang="zh">两个事件在时间上重叠。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#degradesTo">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">态势状态恶化为另一状态。</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">恶化为</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#observedBySensor">
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
