    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <ns1:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSemiMajorAxis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:label xml:lang="zh">半长轴</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
