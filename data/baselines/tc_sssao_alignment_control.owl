    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#affectsState">
    <rdfs:comment xml:lang="zh">空间事件影响态势状态。</rdfs:comment>
    <rdfs:label xml:lang="zh">影响状态</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#modelLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">模型分层</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TimeInterval">
    <rdfs:subClassOf rdf:nodeID="N48ae63660f914e8497ee0d57773fc394"/>
