    <rdfs:subClassOf rdf:nodeID="N3cf0664c63564795b1d234978570fa92"/>
    <rdfs:subClassOf rdf:nodeID="N86847a693cc34bd29acf6eddc504ba06"/>
    <rdfs:subClassOf rdf:nodeID="Neb1b1e2afab6436fad663985cb525f81"/>
    <rdfs:subClassOf rdf:nodeID="N1bdb8d525da64411bce80cf8def19097"/>
    <rdfs:subClassOf rdf:nodeID="N5b69d6af835746479ed9ce4a9ae8585f"/>
    <rdfs:subClassOf rdf:nodeID="Nb177020b82404de0a37e726dd01c9dfe"/>
    <rdfs:subClassOf rdf:nodeID="Ne9e3929bc31c4219bd7e633b727a28d6"/>
    <rdfs:comment xml:lang="zh">描述某一阶段的安全态势。</rdfs:comment>
    <rdfs:label xml:lang="zh">态势状态</rdfs:label>
