  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSecondaryObject">
    <rdfs:label xml:lang="zh">具有次目标</rdfs:label>
    <rdfs:comment xml:lang="zh">空间关系事件中交会对象对的次要目标，用于显式表示目标角色。</rdfs:comment>
