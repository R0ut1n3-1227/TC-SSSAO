  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasPrimaryObject">
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="zh">空间关系事件中交会对象对的主要目标，用于显式表示目标角色。</rdfs:comment>
    <rdfs:label xml:lang="zh">具有主目标</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatConfidence">
    <rdfs:label xml:lang="zh">威胁置信度</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="zh">安全威胁评估的置信度</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5b69d6af835746479ed9ce4a9ae8585f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateDuration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isImplementedByEvent">
    <rdfs:label xml:lang="zh">由事件实施</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#implementsMeasure"/>
    <rdfs:comment xml:lang="zh">响应措施由空间事件实施。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CyberThreat">
    <rdfs:label xml:lang="zh">网络威胁</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdfs:comment xml:lang="zh">通过网络手段对空间系统造成的威胁。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neb1b1e2afab6436fad663985cb525f81">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateUpdateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8a1b4684abe647bb9c4b034885b130d4">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEnvironmentLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateID">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="zh">态势状态唯一标识。</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
