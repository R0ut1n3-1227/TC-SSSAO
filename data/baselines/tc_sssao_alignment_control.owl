    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationEvent"/>
    <rdfs:label xml:lang="zh">由传感器观测</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd3bfcd8e362841408fad39986f7dd874">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N75deaceaa389425e894b49ac34cf1b9a">
