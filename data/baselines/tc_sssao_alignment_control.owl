    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#TemporalEntity"/>
    <ns1:alignmentRationale xml:lang="en">TC-SSSAO TimeInstant is the application-domain time-point representation; it is specialized from time:Instant rather than redefining OWL-Time.</ns1:alignmentRationale>
  </rdf:Description>
