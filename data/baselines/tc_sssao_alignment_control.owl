  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSize">
    <rdfs:label xml:lang="zh">尺寸</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="zh">空间目标的特征尺寸。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasResolution">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="zh">传感器探测分辨率。</rdfs:comment>
    <rdfs:label xml:lang="zh">分辨率</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRiskLevel">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:label xml:lang="zh">风险等级</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="zh">低、中、高、极高。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isOrbitOf">
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#hasOrbit"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">是某目标的轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道属于空间目标。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#naturalLanguageRule">
    <rdfs:label xml:lang="zh">自然语言规则</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1302f2294d7f4b3d83c2e2307ebadc6e">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasCongestionLevel"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9d91cb5d53054569b5b8f6e7b17b0c53">
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RecoveryTransition">
    <rdfs:comment xml:lang="zh">态势从异常/危险向正常恢复的转移。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdfs:label xml:lang="zh">恢复转移</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCollisionProbability">
    <rdfs:label xml:lang="zh">碰撞概率</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CollisionRiskEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="zh">碰撞风险概率。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SensorNetwork">
    <rdfs:comment xml:lang="zh">由多个传感器组成的观测网络。</rdfs:comment>
    <rdfs:label xml:lang="zh">传感器网络</rdfs:label>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#StateTransition">
    <rdfs:subClassOf rdf:nodeID="N34b452c8945f4bb4aac465713d28c4b2"/>
    <rdfs:subClassOf rdf:nodeID="N8611697417fd4ba99b0b7c1d5b934439"/>
    <rdfs:subClassOf rdf:nodeID="N1633bc8a4b914c969b587845b9ede25d"/>
    <rdfs:label xml:lang="zh">状态转移</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态之间的转移。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasPredictedMissDistance">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CollisionRiskEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="zh">预测最近交会距离</rdfs:label>
    <rdfs:comment xml:lang="zh">碰撞风险事件预测最近交会距离。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#stateCausedByEvent">
    <rdfs:comment xml:lang="zh">态势状态由事件导致。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#leadsToState"/>
    <rdfs:label xml:lang="zh">状态由事件导致</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N43c338dc8c3a4bf1af90370a722c3e8e">
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#indicatesThreat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N198f1b23558c479ba2bc9839c90cf103">
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#triggersEvent">
    <rdfs:comment xml:lang="zh">某事件触发另一事件发生。</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:label xml:lang="zh">触发事件</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#generatedBy">
    <rdfs:label xml:lang="zh">由……生成</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns1:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#generatesData"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdfs:comment xml:lang="zh">观测数据由观测系统生成。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne73d3d7ab3264d29b92ad3819c5a79cf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasArgumentOfPerigee"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Naf93adad287f46c1879a99435468722d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#producesRisk"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nba790f48a0434196bb4e4311888f05ed">
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasLaunchCountry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N59373b02112046808b8a001cc15399cb">
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#respondsToEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nde5023716f8f404587c3a985f769341c">
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ArtificialSpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Necd02f141f8345459911ccffe0e0bc79">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOrbit"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAData">
    <ns1:alignmentRationale xml:lang="en">SSAData is information that is produced, used, cited and traced; all data subclasses (ObservationData, AssessmentData, PredictionData, RiskAssessmentData, TrackingData, ...) thereby become prov:Entity.</ns1:alignmentRationale>
    <rdfs:comment xml:lang="zh">支撑因果断言与事件判断的太空态势感知数据。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:label xml:lang="zh">太空态势感知数据</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasLaunchDate">
    <rdfs:comment xml:lang="zh">空间目标的发射日期与时间。</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="zh">发射日期</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#outputRelation">
    <rdfs:label xml:lang="zh">输出关系</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursAtTime">
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#TimeInstant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:label xml:lang="zh">发生于时间点</rdfs:label>
    <rdfs:comment xml:lang="zh">事件发生在某一时间点。</rdfs:comment>
    <ns1:alignmentRationale xml:lang="en">occursAtTime links a SpaceEvent to a TimeInstant (which is aligned with time:Instant); time:hasTime is the generic OWL-Time property connecting a resource to a temporal entity.</ns1:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#InfraredSensor">
    <rdfs:comment xml:lang="zh">以红外为主要感知机制的传感器。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:label xml:lang="zh">红外传感器</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#producesData">
    <rdfs:comment xml:lang="zh">SSA 活动产生 SSA 数据。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAActivity"/>
    <rdfs:label xml:lang="zh">产生活动数据</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#generatedByActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7b05af88713e496b9e4a14192db3cb50">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSemiMajorAxis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5fe09677f2734b118789a40e6a6d0dc3">
    <owl:intersectionOf rdf:nodeID="N75deaceaa389425e894b49ac34cf1b9a"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasObjectName">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的名称。</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">目标名称</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceOrganization">
    <rdfs:label xml:lang="zh">空间组织</rdfs:label>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:comment xml:lang="zh">描述空间相关组织的顶层抽象类。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#mitigatesRisk">
    <rdfs:label xml:lang="zh">缓解风险</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
    <rdfs:comment xml:lang="zh">响应措施缓解安全风险。</rdfs:comment>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#mitigatedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CyberSecurityRisk">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
    <rdfs:comment xml:lang="zh">网络攻击导致的风险。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdfs:label xml:lang="zh">网络安全风险</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PhysicalThreat">
    <rdfs:label xml:lang="zh">物理威胁</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="zh">由物理接近或碰撞等物理作用导致的威胁。</rdfs:comment>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7d79475adf7d484aa26cc5645f227aa1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasPredictedMissDistance"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N34b452c8945f4bb4aac465713d28c4b2">
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasTargetState"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursInOrbit">
    <rdfs:comment xml:lang="zh">空间事件发生于某轨道。</rdfs:comment>
    <rdfs:label xml:lang="zh">发生于轨道</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2e23807ffed947af939086ad028065c1">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasLaunchDate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#respondsToEvent">
    <rdfs:comment xml:lang="zh">响应措施响应空间事件。</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:label xml:lang="zh">响应事件</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceWeather">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:comment xml:lang="zh">空间天气。</rdfs:comment>
    <rdfs:label xml:lang="zh">空间天气</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PredictionData">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">预测数据。</rdfs:comment>
    <rdfs:label xml:lang="zh">预测数据</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursDuringEvent">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:label xml:lang="zh">发生于另一事件期间</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#containsEvent"/>
    <rdfs:comment xml:lang="zh">某事件发生于另一事件期间。</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSpatialRelationship">
    <rdfs:comment xml:lang="zh">空间关系事件中的关系类型</rdfs:comment>
    <rdfs:label xml:lang="zh">空间关系</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#threatMitigatedBy">
    <rdfs:label xml:lang="zh">威胁被缓解</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁被响应措施缓解。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasTargetState">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:comment xml:lang="zh">状态转移的目标状态。</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有目标状态</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#changesOrbit">
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">改变轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件改变轨道。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N20cef7062e624278aad9cc0c58e7f27c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#resultsInEvent"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCausalEvidence">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <ns1:alignmentRationale xml:lang="en">hasCausalEvidence (domain CausalAssertion, range SSAData) states that the assertion is supported by evidence data; with CausalAssertion and SSAData both aligned to prov:Entity, this is a provenance derivation relation. It does NOT express event-level causation (causesEvent): provenance and causal relation are distinct.</ns1:alignmentRationale>
    <rdfs:comment xml:lang="zh">支撑因果断言的 SSA 数据。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有因果证据</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#IndirectCausalAssertion">
    <rdfs:comment xml:lang="zh">原因事件通过中间环节导致结果事件的因果断言。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">间接因果断言</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N51781b33d97148c687d286352563f590">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasRAAN"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#Instant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Payload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="zh">航天器或运载火箭上承载的任务设备或载荷。</rdfs:comment>
    <rdfs:label xml:lang="zh">有效载荷</rdfs:label>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ArtificialSpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncd5d760da9ea4488849165f76030e5f6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSize"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne9e3929bc31c4219bd7e633b727a28d6">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasRiskLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#generatedByActivity">
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAActivity"/>
    <rdfs:label xml:lang="zh">由活动生成</rdfs:label>
    <rdfs:comment xml:lang="zh">SSA 数据由 SSA 活动生成。</rdfs:comment>
    <ns1:alignmentRationale xml:lang="en">Kept formal mapping: generatedByActivity (domain SSAData, range SSAActivity) is a sub-property of prov:wasGeneratedBy; with SSAData aligned to prov:Entity and SSAActivity to prov:Activity, the PROV generation semantics is preserved.</ns1:alignmentRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#producesData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="zh">状态置信度</rdfs:label>
    <rdfs:comment xml:lang="zh">状态判断的可信程度。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ObservationSystem">
    <rdfs:label xml:lang="zh">观测系统</rdfs:label>
    <ns1:reusedOntology rdf:resource="http://www.w3.org/ns/sosa/"/>
    <rdfs:subClassOf rdf:nodeID="Nbce1122ecbdd4b319b6a72bbf924e467"/>
    <rdfs:comment xml:lang="zh">用于探测、监视、跟踪空间目标的观测系统。</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <ns1:alignmentRationale xml:lang="en">TC-SSSAO ObservationSystem is an SSA-oriented aggregate covering sensors, sensor networks, ground stations, tracking and surveillance systems; since Sensor itself is a subclass, ObservationSystem is not strictly synonymous with sosa:Platform, so no formal subclass/equivalent mapping is made.</ns1:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ApproachEvent">
    <rdfs:label xml:lang="zh">接近事件</rdfs:label>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:comment xml:lang="zh">两个空间目标相互接近的事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#WarningMeasure">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:label xml:lang="zh">预警措施</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</ns1:modelLayer>
    <rdfs:comment xml:lang="zh">提前发出预警的响应措施。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#EnvironmentalThreat">
    <rdfs:comment xml:lang="zh">由空间环境异常导致的威胁。</rdfs:comment>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:label xml:lang="zh">环境威胁</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N392b71b6839f4ee98512ad5eb94bb396">
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#detectedFromData"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSourceState">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:comment xml:lang="zh">状态转移的源状态。</rdfs:comment>
    <rdfs:label xml:lang="zh">具有源状态</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#triggeredByEvent">
    <rdfs:label xml:lang="zh">由事件触发</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">触发状态转移的空间事件。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8611697417fd4ba99b0b7c1d5b934439">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#triggeredByEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAActivity">
    <ns1:alignmentRationale xml:lang="en">SSAActivity covers data/knowledge processing activities (observation, tracking, prediction, conjunction assessment); it is a domain specialization of prov:Activity.</ns1:alignmentRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:label xml:lang="zh">空间态势感知活动</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑空间态势感知的各类活动。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb56c34c58744ecb9c1c6c0c2219336f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#mayManifestAsEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#describesObject">
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">描述目标</rdfs:label>
    <rdfs:comment xml:lang="zh">SSA 数据描述空间目标。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#EarthOrbit">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdfs:label xml:lang="zh">地球轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">以地球为中心天体的轨道。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1ad837fb48b04618ab51548d93848d50">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasMissionType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRAAN">
    <rdfs:label xml:lang="zh">升交点赤经</rdfs:label>
    <rdfs:comment xml:lang="zh">升交点赤经（Right Ascension of Ascending Node）。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#OrbitManeuverEvent">
