    <rdfs:subClassOf rdf:nodeID="N1302f2294d7f4b3d83c2e2307ebadc6e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:label xml:lang="zh">轨道拥堵环境</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道拥堵环境。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#mappedToExternalTerm">
    <rdfs:label xml:lang="zh">映射到外部术语</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#containsEvent">
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#occursDuringEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
