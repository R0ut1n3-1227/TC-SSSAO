    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#OrbitalEvent"/>
    <rdfs:subClassOf rdf:nodeID="N7ce2faf4e9ce46dfb9ee03f0c9882916"/>
    <rdfs:subClassOf rdf:nodeID="N82dd7e8b0d224dbda70ae9c1ee556470"/>
