    <rdfs:comment xml:lang="zh">时间维度的顶层抽象。</rdfs:comment>
    <ns1:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</ns1:modelLayer>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
