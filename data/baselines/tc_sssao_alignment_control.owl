    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatID">
    <rdfs:label xml:lang="zh">威胁编号</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
