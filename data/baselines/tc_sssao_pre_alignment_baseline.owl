<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:onto="https://w3id.org/tc-sssao#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间目标</rdfs:label>
    <rdfs:comment xml:lang="zh">太空安全态势感知中的顶层空间目标概念，涵盖自然空间目标与人造空间目标。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N99a965d4618447569673b3a9c0ccc984"/>
    <rdfs:subClassOf rdf:nodeID="Nc5867cc3a6c747349e6864b305351aaa"/>
    <rdfs:subClassOf rdf:nodeID="N6903c04a97e24e73a12cfa47bd3ff249"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <onto:mappedToExternalTerm rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <onto:alignmentRationale xml:lang="en">A SpaceObject can play the SOSA FeatureOfInterest role in concrete observation contexts, but it is a domain entity type; TC-SSSAO does not globally define every space object as a FeatureOfInterest.</onto:alignmentRationale>
    <onto:alignmentRationale xml:lang="en">SpaceObject is a domain entity with spatial location/geometry representation; as a Feature it may be linked to a geo:Geometry via geo:hasGeometry. The previous direct subPropertyOf geo:asWKT shortcut (SpaceObject -&gt; wktLiteral) conflated Feature and Geometry and has been removed.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">描述某一阶段的安全态势。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N0c8c45b81aef4a2bb4fe277285bd2530"/>
    <rdfs:subClassOf rdf:nodeID="Nda702a329f3e4989b56143c6288c6456"/>
    <rdfs:subClassOf rdf:nodeID="N2ff6d487c07c4680afd5b3f613855d4b"/>
    <rdfs:subClassOf rdf:nodeID="N17d268d56244422b97ad6eaa9ee83e46"/>
    <rdfs:subClassOf rdf:nodeID="N2edfe01222fd4e2b95440315cd40d0df"/>
    <rdfs:subClassOf rdf:nodeID="N4c6b2d176ec2487590a5af741c8ca51f"/>
    <rdfs:subClassOf rdf:nodeID="N790708d0e054403da3c533855ab7456e"/>
    <rdfs:subClassOf rdf:nodeID="N77f70304c8874b54b7b2dbf7d3c9c5af"/>
    <rdfs:subClassOf rdf:nodeID="N9a4e9f44570c4e2f8968a61695ab2787"/>
    <rdfs:subClassOf rdf:nodeID="N23c558dc13df415981e8338525c0dc69"/>
    <rdfs:subClassOf rdf:nodeID="Neb9719f74450483fa74b4af27a1f1754"/>
    <rdfs:subClassOf rdf:nodeID="Ne2a71a7583354734ba204cfc03964c27"/>
    <rdfs:subClassOf rdf:nodeID="N9012d797f3134130a52c007a9279e7ef"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRelativeDistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">相对距离</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:comment xml:lang="zh">两目标之间距离。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#DebrisRiskEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">碎片风险事件</rdfs:label>
    <rdfs:comment xml:lang="zh">由空间碎片引发的风险事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RiskEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ObservationData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">观测数据</rdfs:label>
    <rdfs:comment xml:lang="zh">通过观测系统获取的数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:subClassOf rdf:nodeID="Nd612e984f6434063a889315954c7c044"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Result"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/sosa/"/>
    <onto:alignmentRationale xml:lang="en">ObservationData is the data produced by an observation activity, i.e. the result of the act, not the act itself. It is therefore aligned with sosa:Result. The previous seeAlso link to sosa:Observation was conceptually inaccurate and has been removed.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#GroundBasedSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">地基传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">部署于地面的传感器。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasObservationResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有观测结果</rdfs:label>
    <rdfs:comment xml:lang="zh">观测数据具有观测结果目标。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <onto:alignmentRationale xml:lang="en">Local domain property (ObservationData -&gt; SpaceObject): it links observation data to the observed space object, which is NOT the SOSA hasResult relation (Observation -&gt; Result). The former subPropertyOf sosa:hasResult mapping has been removed; the property remains in use as a local property.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RiskEscalationTransition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">风险升级转移</rdfs:label>
    <rdfs:comment xml:lang="zh">风险等级上升的状态转移。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9012d797f3134130a52c007a9279e7ef">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#evolvesTo"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CausalAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">因果断言</rdfs:label>
    <rdfs:comment xml:lang="zh">描述事件之间因果关系的断言。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N980646f379df4031b6c66bb5a4cd7ed1"/>
    <rdfs:subClassOf rdf:nodeID="Nc699feb167ad48c9b71701b210a9085e"/>
    <rdfs:subClassOf rdf:nodeID="N1b1304db56894ab281f94981332906e0"/>
    <rdfs:subClassOf rdf:nodeID="Nbb8d0c2e738b4ac4ab9f52fef95237a7"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <onto:alignmentRationale xml:lang="en">A CausalAssertion is a reified knowledge record (with cause, effect and evidence); as a piece of traceable information it is a prov:Entity.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd612e984f6434063a889315954c7c044">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasErrorValue"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ruleCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">规则类别</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TimeInstant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">时间点</rdfs:label>
    <rdfs:comment xml:lang="zh">零长度的时间点。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <onto:alignmentRationale xml:lang="en">TC-SSSAO TimeInstant is the application-domain time-point representation; it is specialized from time:Instant rather than redefining OWL-Time.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Spacecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">航天器</rdfs:label>
    <rdfs:comment xml:lang="zh">具备特定任务功能、可在轨运行或深空飞行的人造空间飞行器。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ArtificialSpaceObject"/>
    <rdfs:subClassOf rdf:nodeID="N8b2e049cdd854f948f00b862344a43c7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SituationAssessmentData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">态势评估数据</rdfs:label>
    <rdfs:comment xml:lang="zh">态势评估数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#AssessmentData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#stateCausedByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">状态由事件导致</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态由事件导致。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#leadsToState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TrackingSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">跟踪系统</rdfs:label>
    <rdfs:comment xml:lang="zh">用于持续跟踪空间目标的系统。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#transitsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">转移到</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态转移到另一状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#transitsFrom"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2b75ef0410c246529e4ccff9707fc400">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOccurrenceTime"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEnvironmentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">环境类型</rdfs:label>
    <rdfs:comment xml:lang="zh">空间环境所属类型，如辐射环境、电磁环境、轨道拥堵环境等</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasTargetState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有目标状态</rdfs:label>
    <rdfs:comment xml:lang="zh">状态转移的目标状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">数据类型说明。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#overlapsWithEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="zh">与事件时间重叠</rdfs:label>
    <rdfs:comment xml:lang="zh">两个事件在时间上重叠。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#intervalOverlaps"/>
    <onto:alignmentRationale xml:lang="en">time:intervalOverlaps relates time intervals; TC-SSSAO overlapsWithEvent relates SpaceEvent instances with overlapping time intervals. Different semantic level: seeAlso only.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#GroundRadarSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">地基雷达传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">部署于地面的雷达传感器。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#GroundBasedSensor"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RadarSensor"/>
    <owl:equivalentClass rdf:nodeID="N459fe11e2c7f4ec5a734f0984bc8c692"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isImplementedByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由事件实施</rdfs:label>
    <rdfs:comment xml:lang="zh">响应措施由空间事件实施。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#implementsMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRAAN">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">升交点赤经</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">升交点赤经（Right Ascension of Ascending Node）。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RadarObservationData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">雷达观测数据</rdfs:label>
    <rdfs:comment xml:lang="zh">雷达传感器产生的观测数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SensorObservationData"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6903c04a97e24e73a12cfa47bd3ff249">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSize"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#OrbitManeuverEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">轨道机动事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标改变轨道的机动事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#OrbitalEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObjectBehaviorEvent"/>
    <rdfs:subClassOf rdf:nodeID="Nef17e8f5a98c4189b660ef6005ba5b16"/>
    <rdfs:subClassOf rdf:nodeID="N90e28e887477456187b9ca2b81551874"/>
    <rdfs:subClassOf rdf:nodeID="Ne938fd598c7049e3984419fb745fe8f6"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2edfe01222fd4e2b95440315cd40d0df">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateEndTime"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateStartTime">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/2006/time#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态开始时间</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">状态开始时间。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeanAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">平近点角</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">轨道平近点角。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N732b784b26db488392a6cb2bb38202cc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasMeanAnomaly"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasPredictedMissDistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">预测最近交会距离</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CollisionRiskEvent"/>
    <rdfs:comment xml:lang="zh">碰撞风险事件预测最近交会距离。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasOrbitalPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">轨道周期</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">轨道运行周期。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#changesOrbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">改变轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件改变轨道。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#precedesEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="zh">先于事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件在时间上先于另一事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#followsEvent"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#before"/>
    <onto:alignmentRationale xml:lang="en">OWL-Time time:before relates temporal entities; TC-SSSAO precedesEvent relates SpaceEvent instances (domain events, not temporal entities). The two are at different semantic levels, so only a seeAlso reference is kept.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5cd9c1bf736f409fb3272620a7b7df7b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#affectsState"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#GeometricConstruct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">几何构造</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道与空间态势中使用的几何构造抽象。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N37e33f1590a9497898a9b18b5ccb39da"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRiskValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">风险值</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#RiskEvent"/>
    <rdfs:comment xml:lang="zh">由外部风险评估模型、任务系统或应用层给出的可选综合风险评分，其计算方法与取值尺度由外部系统规定，不由本体规定；承载外部评估结果，不等同于碰撞概率 hasCollisionProbability；碰撞风险态势规则（R5—R8）不再以该属性为判定条件。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0577e50e65714e9ab8073d90e92c2145">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSourceState"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#recoversTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">恢复为</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态恢复为另一状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#DangerousSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">危险态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势处于危险级别。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="Nc2cce7c9ed114c4393ff2741aee263c0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#LowEarthOrbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">低地球轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">低地球轨道（LEO）。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#EarthOrbit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2a71a7583354734ba204cfc03964c27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasRiskLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">威胁编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:comment xml:lang="zh">安全威胁唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">太空态势感知数据</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑因果断言与事件判断的太空态势感知数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <onto:alignmentRationale xml:lang="en">SSAData is information that is produced, used, cited and traced; all data subclasses (ObservationData, AssessmentData, PredictionData, RiskAssessmentData, TrackingData, ...) thereby become prov:Entity.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeasureID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">措施编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:comment xml:lang="zh">响应措施唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isOrbitOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">是某目标的轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道属于空间目标。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#hasOrbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEventID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">事件编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">事件唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isInvolvedInEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">参与事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标参与空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/tc-sssao/1.0.0"/>
    <dcterms:title>TC-SSSAO: Temporal-Causal Space Security Situational Awareness Ontology</dcterms:title>
    <dcterms:title xml:lang="zh">TC-SSSAO：时序—因果太空安全态势感知本体</dcterms:title>
    <dcterms:description xml:lang="en">OWL 2 ontology and SHACL-SPARQL rule set for representing and reasoning over space-security situational-awareness knowledge: space objects, orbits, observation systems and data, space events, temporal relations, reified causal assertions, graded situation states, threats, risks, and response measures.</dcterms:description>
    <dcterms:description xml:lang="zh">面向太空安全态势感知知识的 OWL 2 本体与 SHACL-SPARQL 规则集，统一组织空间目标、轨道、观测系统与数据、空间事件、时序关系、实体化因果断言、分级态势状态、威胁、风险与响应措施。</dcterms:description>
    <dcterms:created>2026-07</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-04</dcterms:modified>
    <dcterms:license rdf:resource="https://opensource.org/license/mit"/>
    <rdfs:comment xml:lang="en">Canonical ontology identifier. The IRI is used as the ontology identifier for this release; resolution will be configured when the public repository is published.</rdfs:comment>
    <rdfs:comment xml:lang="zh">规范本体标识符。当前发布包使用该 IRI 作为本体标识；解析地址将在公开仓库发布后同步配置。</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/tc-sssao/alignments"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#containsEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">包含事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件包含另一事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#occursDuringEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nda702a329f3e4989b56143c6288c6456">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndf99a52b1b444649a5db215d91d7e22a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasThreatSource"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#threatMitigatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">威胁被缓解</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁被响应措施缓解。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCausalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有因果证据</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑因果断言的 SSA 数据。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <onto:alignmentRationale xml:lang="en">hasCausalEvidence (domain CausalAssertion, range SSAData) states that the assertion is supported by evidence data; with CausalAssertion and SSAData both aligned to prov:Entity, this is a provenance derivation relation. It does NOT express event-level causation (causesEvent): provenance and causal relation are distinct.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#AttentionSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">关注态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势需要关注。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="N17a9e4c01ef84731b736fc2f98c2ac34"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#WarningSituationState"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#DangerousSituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#WarningSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">预警态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势达到预警级别。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="N4fc30fc4099f4987a9c8b8e33aed89b6"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#DangerousSituationState"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N63f19fae64764f54bbd08a2cd89b7265">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#respondsToEvent"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSensorID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">传感器编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
    <rdfs:comment xml:lang="zh">传感器唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有原因</rdfs:label>
    <rdfs:comment xml:lang="zh">因果断言中的原因事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3b1efe36b46643fbac87e336dcfd30fb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#mayManifestAsEvent"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N17d268d56244422b97ad6eaa9ee83e46">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateStartTime"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb86c53d8de9346939783ae825909cae8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc3a201c9583401dbd85a72b3cd99845">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="Nf4632860af3a47bb9701b69544cc3ab6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursInTimeInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">发生于时间区间</rdfs:label>
    <rdfs:comment xml:lang="zh">事件发生在某一时间区间内。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#TimeInterval"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
    <onto:alignmentRationale xml:lang="en">occursInTimeInterval links a SpaceEvent to a TimeInterval (aligned with time:Interval); it is therefore a specialization of time:hasTime.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStartTime">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/2006/time#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">开始时间</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">事件开始时间。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">尺寸</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的特征尺寸。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CyberThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">网络威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">通过网络手段对空间系统造成的威胁。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#DebrisRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">碎片风险</rdfs:label>
    <rdfs:comment xml:lang="zh">空间碎片导致的风险。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SecurityThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">安全威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">可能对太空资产、轨道环境或任务系统造成危害的威胁类型。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N3b1efe36b46643fbac87e336dcfd30fb"/>
    <rdfs:subClassOf rdf:nodeID="Na593d88692714961afb9da58f6921665"/>
    <rdfs:subClassOf rdf:nodeID="Ne3db641b82ee4f159ca81c3bde9619f8"/>
    <rdfs:subClassOf rdf:nodeID="Nf46b2e13196a4f3eb26f4c0ee287075f"/>
    <rdfs:subClassOf rdf:nodeID="Ne656913af0494b8bb2152f111c85a83e"/>
    <rdfs:subClassOf rdf:nodeID="N307b350c13544da2954ff8947f988d12"/>
    <rdfs:subClassOf rdf:nodeID="Ndf99a52b1b444649a5db215d91d7e22a"/>
    <rdfs:subClassOf rdf:nodeID="Nc3e4efd0ba92465cb47eb1a7c0a7f6df"/>
    <rdfs:subClassOf rdf:nodeID="N2d5c50bc7c31484e95239b84c53df821"/>
    <rdfs:subClassOf rdf:nodeID="N857946c6f7eb479a94da9e8ce5e2e71e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有结果</rdfs:label>
    <rdfs:comment xml:lang="zh">因果断言中的结果事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCollisionProbability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">碰撞概率</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CollisionRiskEvent"/>
    <rdfs:comment xml:lang="zh">碰撞风险概率。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#triggersEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">触发事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件触发另一事件发生。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasObjectName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">目标名称</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的名称。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#detectedFromData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由数据发现</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件由 SSA 数据发现。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataSource">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据来源</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">数据来源说明。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#degradesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">恶化为</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态恶化为另一状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#alignmentRationale">
    <rdfs:comment xml:lang="zh">说明 TC-SSSAO 与标准词汇之间采用 subClassOf / subPropertyOf / seeAlso 或不做正式对齐的理由。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">对齐理由</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasFeatureOfInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有关注目标</rdfs:label>
    <rdfs:comment xml:lang="zh">SSA 数据所关注的空间目标。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <onto:alignmentRationale xml:lang="en">Local domain property (SSAData -&gt; SpaceObject): a data record points to its target of interest, whereas SOSA hasFeatureOfInterest relates an Observation/Actuation/Sampling ACT to its feature. Different semantic level; the former subPropertyOf sosa:hasFeatureOfInterest mapping has been removed.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMissionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">任务类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Spacecraft"/>
    <rdfs:comment xml:lang="zh">航天器承担的任务类型。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N939b44454d124a5ab26feb2bf9d5a4ba">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#increasesThreat"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4f57fc36911c46c6899b5bcb9007499c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasCollisionProbability"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nec1403dbc90d4f0c8c0c403e2a41daff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOrbitalPeriod"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N52b9597f473842828dbcea39f42aa0c8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">质量</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的质量，通常以千克为单位。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d67010a32064b019f1a98fd2c126393">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasRiskDescription"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">威胁类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:comment xml:lang="zh">威胁类型，如物理、网络、电磁、环境、运行等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#generatedBy">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由……生成</rdfs:label>
    <rdfs:comment xml:lang="zh">观测数据由观测系统生成。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#generatesData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#requiresResponseMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">需要响应措施</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁需要响应措施。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#respondsToThreat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRiskLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">风险等级</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">低、中、高、极高。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasOccurrenceTime">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#hasTime"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/2006/time#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">发生时间</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">事件发生时间。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SecurityRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">安全风险</rdfs:label>
    <rdfs:comment xml:lang="zh">空间系统或任务面临损失的潜在可能性。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="Nfd349f09c56a4211981b5db55646f889"/>
    <rdfs:subClassOf rdf:nodeID="N73498b45eaa64b73a8e3aa1ff218c9ee"/>
    <rdfs:subClassOf rdf:nodeID="N2d67010a32064b019f1a98fd2c126393"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursDuringEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">发生于另一事件期间</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件发生于另一事件期间。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#containsEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4fc30fc4099f4987a9c8b8e33aed89b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#resultsInEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">产生事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件产生另一事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#resultedFromEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间事件</rdfs:label>
    <rdfs:comment xml:lang="zh">描述引起态势变化的空间事件。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N18f25bf1cd28498c9149e3ec0bbd38db"/>
    <rdfs:subClassOf rdf:nodeID="Nbcc6e52fcff249efb3aa49133f62f895"/>
    <rdfs:subClassOf rdf:nodeID="N3d2fdde028a1453abed8e5ab57c04fb7"/>
    <rdfs:subClassOf rdf:nodeID="N2b75ef0410c246529e4ccff9707fc400"/>
    <rdfs:subClassOf rdf:nodeID="N526f5aa59dae41a890c9253c4849387d"/>
    <rdfs:subClassOf rdf:nodeID="N2f56e61b780945cab7315f69eb490a33"/>
    <rdfs:subClassOf rdf:nodeID="N1f181f7af14d4e2d998bb207bd8c86ce"/>
    <rdfs:subClassOf rdf:nodeID="Nb86c53d8de9346939783ae825909cae8"/>
    <rdfs:subClassOf rdf:nodeID="Nfeef54fc3e48400a89cfc688835e52c5"/>
    <rdfs:subClassOf rdf:nodeID="N98d564549c1a4b8882a1956d66704b0e"/>
    <rdfs:subClassOf rdf:nodeID="Nabb4478bb4a2486a88bceac7a67869fe"/>
    <rdfs:subClassOf rdf:nodeID="N00978e322a914bd6b1e665c270dcfd93"/>
    <rdfs:subClassOf rdf:nodeID="N205808d9ac1046a48c2ee9e480f08fba"/>
    <rdfs:subClassOf rdf:nodeID="N7407776bd4134261ab96dcea3f5aadee"/>
    <rdfs:subClassOf rdf:nodeID="N509fbd58a0704972bd567d9d672a56f9"/>
    <rdfs:subClassOf rdf:nodeID="N9f2150dacc0648fb8b22a956f78591f5"/>
    <rdfs:subClassOf rdf:nodeID="N5cd9c1bf736f409fb3272620a7b7df7b"/>
    <rdfs:subClassOf rdf:nodeID="N0381c45043bc479faf902642a8d0030a"/>
    <rdfs:subClassOf rdf:nodeID="N6ad6f7ae9f2e468d9ab236d8698f5911"/>
    <rdfs:subClassOf rdf:nodeID="Ne328e9a239b44fe2a969e21017db5fc8"/>
    <rdfs:subClassOf rdf:nodeID="N939b44454d124a5ab26feb2bf9d5a4ba"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#supportedByData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由数据支撑</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件由 SSA 数据支撑。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#IndirectCausalAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">间接因果断言</rdfs:label>
    <rdfs:comment xml:lang="zh">原因事件通过中间环节导致结果事件的因果断言。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#madeBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由传感器执行</rdfs:label>
    <rdfs:comment xml:lang="zh">观测活动由传感器执行。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
    <onto:alignmentRationale xml:lang="en">Kept formal mapping: madeBySensor (domain ObservationActivity, range Sensor) is a sub-property of sosa:madeBySensor; with ObservationActivity aligned to sosa:Observation and Sensor to sosa:Sensor, the SOSA Observation-&gt;Sensor semantics is preserved.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCongestionLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#OrbitalCongestionEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">拥堵等级</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道拥堵环境等级</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PredictionData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">预测数据</rdfs:label>
    <rdfs:comment xml:lang="zh">预测数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RocketDebris">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">火箭碎片</rdfs:label>
    <rdfs:comment xml:lang="zh">由火箭体产生的空间碎片。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceDebris"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ResponseMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">响应措施</rdfs:label>
    <rdfs:comment xml:lang="zh">为应对安全威胁或安全风险采取的措施。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N95793ddd1d54416d87e1367e07be648d"/>
    <rdfs:subClassOf rdf:nodeID="N63f19fae64764f54bbd08a2cd89b7265"/>
    <rdfs:subClassOf rdf:nodeID="Nb28e40aef72148deabc591b0a932fc2f"/>
    <rdfs:subClassOf rdf:nodeID="Nd5a616b935b84a00aa82e77e4e139e1e"/>
    <rdfs:subClassOf rdf:nodeID="N3ab95f16a189420e96d5c207121d8158"/>
    <rdfs:subClassOf rdf:nodeID="N6962d0d3324d4ef29005401da52fe71b"/>
    <rdfs:subClassOf rdf:nodeID="N35f510308c75454a9ebb732088a3a888"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasResolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">分辨率</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
    <rdfs:comment xml:lang="zh">传感器探测分辨率。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#indicatesThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:label xml:lang="zh">指示威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件指示相关安全威胁</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="zh">威胁置信度</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁评估的置信度</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#generatesData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">生成数据</rdfs:label>
    <rdfs:comment xml:lang="zh">观测系统生成观测数据。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#generatedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#riskLeadsToState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">风险导致状态</rdfs:label>
    <rdfs:comment xml:lang="zh">安全风险导致态势状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasObjectID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">目标编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的唯一标识编号。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PromotingCausalAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">促进型因果断言</rdfs:label>
    <rdfs:comment xml:lang="zh">原因事件促进但非必然导致结果事件的因果断言。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N526f5aa59dae41a890c9253c4849387d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStartTime"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCausalConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">因果置信度</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:comment xml:lang="zh">因果断言的可选置信度元数据。当数据来源、专家评估或外部模型提供定量置信信息时记录该值；来源未给出定量置信度时不强制赋值（M3 第一阶段起由 exactly 1 放宽为 max 1）。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#GroundStation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">地面站</rdfs:label>
    <rdfs:comment xml:lang="zh">用于数据接收、指令发送与任务控制的地面站。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
  </rdf:Description>
