  <rdf:Description rdf:about="https://w3id.org/tc-sssao#generatedByActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由活动生成</rdfs:label>
    <rdfs:comment xml:lang="zh">SSA 数据由 SSA 活动生成。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAActivity"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#producesData"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <onto:alignmentRationale xml:lang="en">Kept formal mapping: generatedByActivity (domain SSAData, range SSAActivity) is a sub-property of prov:wasGeneratedBy; with SSAData aligned to prov:Entity and SSAActivity to prov:Activity, the PROV generation semantics is preserved.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#AssessmentData">
