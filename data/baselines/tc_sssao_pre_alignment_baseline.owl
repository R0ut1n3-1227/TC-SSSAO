  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有结束</rdfs:label>
    <rdfs:comment xml:lang="zh">时间区间的结束时间点。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#TimeInterval"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#TimeInstant"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd3726386bcd145fc94f96f497d14d6d2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#triggeredByEvent"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1f181f7af14d4e2d998bb207bd8c86ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEventConfidence"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CyberSecurityRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">网络安全风险</rdfs:label>
    <rdfs:comment xml:lang="zh">网络攻击导致的风险。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSpatialRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">空间关系</rdfs:label>
    <rdfs:comment xml:lang="zh">空间关系事件中的关系类型</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#TrackingData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">跟踪数据</rdfs:label>
    <rdfs:comment xml:lang="zh">跟踪数据。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasArgumentOfPerigee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">近地点幅角</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">轨道近地点幅角。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasOrbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标具有轨道。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#isOrbitOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na593d88692714961afb9da58f6921665">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#producesRisk"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PhysicalThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">物理威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">由物理接近或碰撞等物理作用导致的威胁。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N315d672b631f443a97bacf4498b4f1e2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasLaunchDate"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#WarningMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">预警措施</rdfs:label>
    <rdfs:comment xml:lang="zh">提前发出预警的响应措施。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne11246b69f5548d2a6547783be9cf66b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasBeginning"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#TimeInstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#triggeredByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由事件触发</rdfs:label>
    <rdfs:comment xml:lang="zh">触发状态转移的空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ArtificialSpaceObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">人造空间目标</rdfs:label>
    <rdfs:comment xml:lang="zh">由人类制造并发射至外层空间的目标。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:subClassOf rdf:nodeID="N315d672b631f443a97bacf4498b4f1e2"/>
    <rdfs:subClassOf rdf:nodeID="Nb8824ef7e6eb42e7821c915ff8dcffd4"/>
    <rdfs:subClassOf rdf:nodeID="Nfee847871657479888c72ae9c657a187"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#FragmentationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">解体事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标发生碎裂或解体的事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#OrbitalEvent"/>
    <rdfs:subClassOf rdf:nodeID="N52b9597f473842828dbcea39f42aa0c8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd1eedc6e061341df8b0ce7e73addb1f5">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#RadarSensor"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态置信度</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">状态判断的可信程度。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#leadsToState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">导致状态</rdfs:label>
    <rdfs:comment xml:lang="zh">事件导致态势状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#stateCausedByEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">威胁来源</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:comment xml:lang="zh">威胁来源，如碎片、目标、环境、网络等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#OrbitalEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">轨道事件</rdfs:label>
    <rdfs:comment xml:lang="zh">发生在轨道环境中、由轨道运动直接引发的轨道事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:subClassOf rdf:nodeID="N1d175e347b1a41c094ecf8958374d7b9"/>
    <rdfs:subClassOf rdf:nodeID="N6ec70b5b7ec7450db04db876d4f448fc"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRadiationLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#RadiationEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">辐射水平</rdfs:label>
    <rdfs:comment xml:lang="zh">辐射环境水平等级</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">能够探测空间目标的传感器。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
    <rdfs:subClassOf rdf:nodeID="Naa922c6d633d4846a8d027e96f392c3f"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <onto:mappedToExternalTerm rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <onto:alignmentRationale xml:lang="en">TC-SSSAO Sensor represents sensing systems used for SSA and is modeled as a domain-specific specialization of sosa:Sensor.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3a71dd3da3e347aabb9bf78b4e15da2e">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#InfraredSensor"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9be0dc4c99c649178089f67c10d84aa1">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#IndirectCausalAssertion"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据置信度</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">数据可信程度。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RadarSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">雷达传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">以雷达为主要感知机制的传感器。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Naebde2a6c992401abc72973deacad692">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#affectsOrbit"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbf7b5db1650d48c1999ad2b9846d930f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasTargetState"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N95793ddd1d54416d87e1367e07be648d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#respondsToThreat"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N857946c6f7eb479a94da9e8ce5e2e71e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasThreatConfidence"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncedf7e61937948a3ae9b38cb0292570d">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#InhibitingCausalAssertion"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#RadiationEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">辐射环境</rdfs:label>
    <rdfs:comment xml:lang="zh">辐射环境。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:subClassOf rdf:nodeID="Na12beb296d424934a1873a3631f0ca1e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Orbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">描述空间目标运行轨道。</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <onto:reusedOntology rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:subClassOf rdf:nodeID="Nc2e7538b980f4ab4937878fdb0fe8cc2"/>
    <rdfs:subClassOf rdf:nodeID="N9d1910fded4d4ecb82c6e41eb19f8bd0"/>
    <rdfs:subClassOf rdf:nodeID="N53b53e589be6486092749b383cba2860"/>
    <rdfs:subClassOf rdf:nodeID="N732b784b26db488392a6cb2bb38202cc"/>
    <rdfs:subClassOf rdf:nodeID="Nec1403dbc90d4f0c8c0c403e2a41daff"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <onto:alignmentRationale xml:lang="en">Orbit is modeled as a domain object carrying orbital parameters, orbit type and trajectory geometry, not as a pure geometry node; it is therefore a geo:Feature whose actual path geometry can be linked via geo:hasGeometry. Orbit is not equivalent to geo:Geometry.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2f56e61b780945cab7315f69eb490a33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEndTime"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Payload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">有效载荷</rdfs:label>
    <rdfs:comment xml:lang="zh">航天器或运载火箭上承载的任务设备或载荷。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ArtificialSpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#causesEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">导致事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件导致另一事件发生。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#causedByEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">SSA 数据唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#resultedFromEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由事件产生</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件由另一事件产生。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#resultsInEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SensorNetwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">传感器网络</rdfs:label>
    <rdfs:comment xml:lang="zh">由多个传感器组成的观测网络。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间态势感知活动</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑空间态势感知的各类活动。</rdfs:comment>
    <onto:alignmentRationale xml:lang="en">SSAActivity covers data/knowledge processing activities (observation, tracking, prediction, conjunction assessment); it is a domain specialization of prov:Activity.</onto:alignmentRationale>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nabb4478bb4a2486a88bceac7a67869fe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasDuration"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8b2e049cdd854f948f00b862344a43c7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasMissionType"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间组织</rdfs:label>
    <rdfs:comment xml:lang="zh">描述空间相关组织的顶层抽象类。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N21650358db624a64ae41c949d9a026cf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#detectedFromData"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ObservationData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#OrbitalCongestionEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">轨道拥堵环境</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道拥堵环境。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:subClassOf rdf:nodeID="N77509abca1d241dc9d84f065730644f0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">态势状态唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N815015f318dc4cb5b2ebd973fcf2b5e2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEnvironmentType"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursInOrbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">发生于轨道</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件发生于某轨道。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ObservationActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">观测活动</rdfs:label>
    <rdfs:comment xml:lang="zh">对空间目标进行观测的活动。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SSAActivity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <onto:alignmentRationale xml:lang="en">ObservationActivity is the activity of observing space objects; this corresponds to the observation act in SOSA, so it is specialized from sosa:Observation. This makes madeBySensor (domain ObservationActivity, range Sensor) consistent with its super-property sosa:madeBySensor.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5bf669ff2758422aa3e9e965d5de2281">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEnvironmentLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc3711693c9a3445fa235e475aeefd871">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#AttentionSituationState"/>
    <rdf:rest rdf:nodeID="N568b600aa9ad4170b606a42700dfe2a3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73498b45eaa64b73a8e3aa1ff218c9ee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#riskLeadsToState"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne3db641b82ee4f159ca81c3bde9619f8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#requiresResponseMeasure"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSemiMajorAxis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">半长轴</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">轨道半长轴。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasLaunchDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">发射日期</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的发射日期与时间。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#EnvironmentalThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">环境威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">由空间环境异常导致的威胁。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasLaunchCountry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">发射国家</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:comment xml:lang="zh">空间目标的发射国家或责任机构。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeasureLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">措施等级</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:comment xml:lang="zh">措施等级，如一般、重要、紧急。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDuration">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#hasXSDDuration"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/2006/time#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">持续时间</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">事件持续时间（ISO 8601 时长字符串,如 PT1H30M）。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEventConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">事件置信度</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">事件判断可信程度。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEventType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">事件类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">轨道机动、接近、碰撞风险等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ElectromagneticEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">电磁环境</rdfs:label>
    <rdfs:comment xml:lang="zh">电磁环境。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpatialRelationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间关系事件</rdfs:label>
    <rdfs:comment xml:lang="zh">描述多个空间目标之间空间关系的事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:subClassOf rdf:nodeID="Na1387cd79ac246f7a267441be636acee"/>
    <rdfs:subClassOf rdf:nodeID="Ne58c38eeb6a84aa2a377a98172f0864f"/>
    <rdfs:subClassOf rdf:nodeID="N99302e60ea32407a814802d2a2ef3648"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#respondsToThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">响应威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">响应措施响应安全威胁。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#requiresResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ObjectBehaviorEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">目标行为事件</rdfs:label>
    <rdfs:comment xml:lang="zh">由空间目标自身行为引发的事件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:subClassOf rdf:nodeID="N84538daa0c9a402d908a5670ae057b71"/>
    <rdfs:subClassOf rdf:nodeID="Naebde2a6c992401abc72973deacad692"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N00978e322a914bd6b1e665c270dcfd93">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#affectsObject"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ObservationSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">观测系统</rdfs:label>
    <rdfs:comment xml:lang="zh">用于探测、监视、跟踪空间目标的观测系统。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N39a2fa085a454489aefdd3150d82f87b"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/sosa/"/>
    <onto:alignmentRationale xml:lang="en">TC-SSSAO ObservationSystem is an SSA-oriented aggregate covering sensors, sensor networks, ground stations, tracking and surveillance systems; since Sensor itself is a subclass, ObservationSystem is not strictly synonymous with sosa:Platform, so no formal subclass/equivalent mapping is made.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N568b600aa9ad4170b606a42700dfe2a3">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#WarningSituationState"/>
    <rdf:rest rdf:nodeID="Nf02d924993de4cf6b957b414578e825f"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#followsEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="zh">后于事件</rdfs:label>
    <rdfs:comment xml:lang="zh">某事件在时间上后于另一事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#precedesEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N790708d0e054403da3c533855ab7456e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N99a965d4618447569673b3a9c0ccc984">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOrbit"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfd349f09c56a4211981b5db55646f889">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#mitigatedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#AvoidanceMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">规避措施</rdfs:label>
    <rdfs:comment xml:lang="zh">通过规避动作降低威胁或风险的措施。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#respondsToEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">响应事件</rdfs:label>
    <rdfs:comment xml:lang="zh">响应措施响应空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc699feb167ad48c9b71701b210a9085e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEffect"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne938fd598c7049e3984419fb745fe8f6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasManeuverType"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#involvesObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">涉及目标</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件涉及空间目标。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#isInvolvedInEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">发生于时间点</rdfs:label>
    <rdfs:comment xml:lang="zh">事件发生在某一时间点。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#TimeInstant"/>
    <onto:alignmentRationale xml:lang="en">occursAtTime links a SpaceEvent to a TimeInstant (which is aligned with time:Instant); time:hasTime is the generic OWL-Time property connecting a resource to a temporal entity.</onto:alignmentRationale>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CollisionRiskEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">碰撞风险事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标之间存在碰撞风险的事件。作为空间关系事件，通过 hasPrimaryObject/hasSecondaryObject 显式表示交会目标角色。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RiskEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:subClassOf rdf:nodeID="N4f57fc36911c46c6899b5bcb9007499c"/>
    <rdfs:subClassOf rdf:nodeID="N3a7a4e0b7b0045bbb2519ce5502c4f5e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#transitsFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">转移自</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态转移自另一状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#transitsTo"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc2cce7c9ed114c4393ff2741aee263c0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N980646f379df4031b6c66bb5a4cd7ed1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasCause"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd5a616b935b84a00aa82e77e4e139e1e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#isImplementedByEvent"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#DataProvider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">数据提供方</rdfs:label>
    <rdfs:comment xml:lang="zh">提供空间观测或态势数据的组织。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceOrganization"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <onto:alignmentRationale xml:lang="en">DataProvider is the agent that provides SSA data; it is a domain specialization of prov:Agent.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
