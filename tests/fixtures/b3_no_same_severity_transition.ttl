@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix onto:  <https://w3id.org/tc-sssao#> .
@prefix BT:    <https://w3id.org/tc-sssao/data/boundary-test#> .

# B3 No Same Severity Transition: Warning -> Warning (same severity)
# Should NOT generate transitsTo (r1 == r2)
onto:Config a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "1.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "1.0E-4"^^xsd:float .

onto:SatA a onto:Spacecraft .
onto:SatB a onto:Spacecraft .

# T1: Warning state at 11:00
BT:Assess_T1 a onto:AssessmentData .
BT:T1 a onto:CollisionRiskEvent ;
    onto:hasEventID "T1"^^xsd:string ;
    onto:hasEncounterID "TEST-ENC-01"^^xsd:string ;
    onto:hasCollisionProbability "5.0E-4"^^xsd:float ;
    onto:hasPredictedMissDistance "0.05"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.01"^^xsd:float ;
    onto:hasPrimaryObject onto:SatA ;
    onto:hasSecondaryObject onto:SatB ;
    onto:hasOccurrenceTime "2026-08-01T11:00:00Z"^^xsd:dateTime ;
    onto:supportedByData BT:Assess_T1 .

# T2: Warning state at 12:00 (same severity)
BT:Assess_T2 a onto:AssessmentData .
BT:T2 a onto:CollisionRiskEvent ;
    onto:hasEventID "T2"^^xsd:string ;
    onto:hasEncounterID "TEST-ENC-01"^^xsd:string ;
    onto:hasCollisionProbability "2.0E-4"^^xsd:float ;
    onto:hasPredictedMissDistance "0.08"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.01"^^xsd:float ;
    onto:hasPrimaryObject onto:SatA ;
    onto:hasSecondaryObject onto:SatB ;
    onto:hasOccurrenceTime "2026-08-01T12:00:00Z"^^xsd:dateTime ;
    onto:supportedByData BT:Assess_T2 .

BT:T1 onto:precedesEvent BT:T2 .
