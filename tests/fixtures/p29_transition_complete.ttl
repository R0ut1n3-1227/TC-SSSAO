@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix onto:  <https://w3id.org/tc-sssao#> .

# P29: Complete StateTransition (hasSourceState, hasTargetState, triggeredByEvent) -> should PASS
onto:Config a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "1.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "1.0E-4"^^xsd:float .

onto:SourceState a onto:NormalSituationState ;
    onto:hasStateID "P29-Source"^^xsd:string ;
    onto:hasSeverityRank "0"^^xsd:integer .

onto:TargetState a onto:WarningSituationState ;
    onto:hasStateID "P29-Target"^^xsd:string ;
    onto:hasSeverityRank "2"^^xsd:integer .

onto:TriggerEvent a onto:SpaceEvent ;
    onto:hasEventID "P29-Trigger"^^xsd:string ;
    onto:hasStartTime "2026-08-01T10:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-01T10:30:00Z"^^xsd:dateTime .

onto:Transition a onto:StateTransition ;
    onto:hasSourceState onto:SourceState ;
    onto:hasTargetState onto:TargetState ;
    onto:triggeredByEvent onto:TriggerEvent .
