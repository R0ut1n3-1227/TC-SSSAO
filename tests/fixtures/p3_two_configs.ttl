@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix onto:  <https://w3id.org/tc-sssao#> .

# P3: 2 RuleDeploymentConfiguration instances -> should FAIL
onto:Config1 a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "1.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "1.0E-4"^^xsd:float .

onto:Config2 a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "2.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "2.0E-4"^^xsd:float .
