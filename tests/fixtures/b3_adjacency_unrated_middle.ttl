@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix onto:  <https://w3id.org/tc-sssao#> .
@prefix BT:    <https://w3id.org/tc-sssao/data/boundary-test#> .

# B3 Adjacency Test: T1 rated -> T2 unrated -> T3 rated
# T1 and T3 are adjacent in time but have unrated T2 between them
# T1(11:00) -> T2(12:00, unrated) -> T3(13:00)
# T1 and T3 should NOT have transitsTo because T2 breaks adjacency
onto:Config a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "1.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "1.0E-4"^^xsd:float .

onto:SatA a onto:Spacecraft .
onto:SatB a onto:Spacecraft .

# T1: Risk event at 11:00 with Normal state (Pc <= thetaA)
BT:Assess_T1 a onto:AssessmentData .
BT:T1 a onto:CollisionRiskEvent ;
    onto:hasEventID "T1"^^xsd:string ;
    onto:hasEncounterID "TEST-ENC-01"^^xsd:string ;
    onto:hasCollisionProbability "5.0E-8"^^xsd:float ;
    onto:hasPredictedMissDistance "0.5"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.01"^^xsd:float ;
    onto:hasPrimaryObject onto:SatA ;
    onto:hasSecondaryObject onto:SatB ;
    onto:hasOccurrenceTime "2026-08-01T11:00:00Z"^^xsd:dateTime ;
    onto:supportedByData BT:Assess_T1 .

# T2: Unrated collision event at 12:00 (no assessment/prediction data, so no state derived)
BT:Obs_T2 a onto:RadarObservationData .
BT:T2 a onto:CollisionRiskEvent ;
    onto:hasEventID "T2"^^xsd:string ;
    onto:hasEncounterID "TEST-ENC-01"^^xsd:string ;
    onto:hasCollisionProbability "5.0E-6"^^xsd:float ;
    onto:hasPredictedMissDistance "0.3"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.01"^^xsd:float ;
    onto:hasPrimaryObject onto:SatA ;
    onto:hasSecondaryObject onto:SatB ;
    onto:hasOccurrenceTime "2026-08-01T12:00:00Z"^^xsd:dateTime ;
    onto:detectedFromData BT:Obs_T2 .

# T3: Risk event at 13:00 with Warning state (Pc > thetaM)
BT:Assess_T3 a onto:AssessmentData .
BT:T3 a onto:CollisionRiskEvent ;
    onto:hasEventID "T3"^^xsd:string ;
    onto:hasEncounterID "TEST-ENC-01"^^xsd:string ;
    onto:hasCollisionProbability "5.0E-4"^^xsd:float ;
    onto:hasPredictedMissDistance "0.05"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.01"^^xsd:float ;
    onto:hasPrimaryObject onto:SatA ;
    onto:hasSecondaryObject onto:SatB ;
    onto:hasOccurrenceTime "2026-08-01T13:00:00Z"^^xsd:dateTime ;
    onto:supportedByData BT:Assess_T3 .

# Pre-established precedes relationships
BT:T1 onto:precedesEvent BT:T2 .
BT:T2 onto:precedesEvent BT:T3 .
