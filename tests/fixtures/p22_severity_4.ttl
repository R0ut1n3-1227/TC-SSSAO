@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix onto:  <https://w3id.org/tc-sssao#> .

# P22: hasSeverityRank = 4 -> should FAIL
onto:Config a onto:RuleDeploymentConfiguration ;
    onto:attentionPcThreshold "1.0E-7"^^xsd:float ;
    onto:mitigationPcThreshold "1.0E-4"^^xsd:float .

onto:State a onto:DangerousSituationState ;
    onto:hasStateID "P22"^^xsd:string ;
    onto:hasSeverityRank "4"^^xsd:integer .
