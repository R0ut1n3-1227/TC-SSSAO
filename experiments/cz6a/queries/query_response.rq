PREFIX onto: <https://w3id.org/tc-sssao#>
PREFIX case: <https://w3id.org/tc-sssao/data/cz6a-case#>
# B4/B5 投影后的威胁—风险—响应关系：威胁由 B4 经 indicatesThreat 派生，
# 响应关系由 B5 基于显式 respondsToEvent 知识建立
SELECT ?threat ?measure ?risk
WHERE {
  case:CZ6A_DebrisRiskEvent onto:indicatesThreat ?threat .
  ?threat onto:requiresResponseMeasure ?measure .
  OPTIONAL { ?measure onto:respondsToEvent ?event }
  OPTIONAL { ?threat onto:producesRisk ?risk }
  OPTIONAL { ?measure onto:mitigatesRisk ?risk }
}
