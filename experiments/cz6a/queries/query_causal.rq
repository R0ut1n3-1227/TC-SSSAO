PREFIX onto: <https://w3id.org/tc-sssao#>
SELECT ?assertion ?cause ?effect ?evidence ?confidence ?mechanism
WHERE {
  ?assertion a onto:CausalAssertion ;
             onto:hasCause ?cause ;
             onto:hasEffect ?effect ;
             onto:hasCausalEvidence ?evidence .
  # M3 第一阶段：hasCausalConfidence 为可选元数据，来源未给出时不强制赋值
  OPTIONAL { ?assertion onto:hasCausalConfidence ?confidence }
  OPTIONAL { ?assertion onto:hasCausalMechanism ?mechanism }
}
ORDER BY ?assertion
