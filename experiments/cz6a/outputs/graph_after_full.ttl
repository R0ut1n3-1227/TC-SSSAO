    rdfs:comment "几何构造的误差值。"@zh ;
    rdfs:domain onto:GeometricConstruct ;
    rdfs:range xsd:float .

onto:hasImpactScope a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "影响范围"@zh ;
    rdfs:comment "威胁影响范围，如目标、轨道区域、任务系统等。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasLaunchCountry a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "发射国家"@zh ;
    rdfs:comment "空间目标的发射国家或责任机构。"@zh ;
