    rdfs:range xsd:string .

onto:hasLaunchDate a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "发射日期"@zh ;
    rdfs:comment "空间目标的发射日期与时间。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:dateTime .

onto:hasManeuverType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "机动类型"@zh ;
    rdfs:comment "轨道机动事件类型"@zh ;
    rdfs:domain onto:OrbitManeuverEvent ;
    rdfs:range xsd:string .

onto:hasMass a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "质量"@zh ;
    rdfs:comment "空间目标的质量，通常以千克为单位。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:float .

onto:hasMeanAnomaly a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "平近点角"@zh ;
    rdfs:comment "轨道平近点角。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range xsd:float .

onto:hasMeasureLevel a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施等级"@zh ;
    rdfs:comment "措施等级，如一般、重要、紧急。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasMeasureLevel .

onto:hasMeasureType a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施类型"@zh ;
    rdfs:comment "措施类型，如规避、应急、缓解、预警等。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasMeasureType .

onto:hasMissionType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "任务类型"@zh ;
    rdfs:comment "航天器承担的任务类型。"@zh ;
    rdfs:domain onto:Spacecraft ;
    rdfs:range xsd:string .

onto:hasObjectID a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "目标编号"@zh ;
