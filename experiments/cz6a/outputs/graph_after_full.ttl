onto:affectsOrbit a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "影响轨道"@zh ;
    rdfs:comment "空间事件影响轨道。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:Orbit .

onto:affectsState a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "影响状态"@zh ;
    rdfs:comment "空间事件影响态势状态。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SituationState .

onto:alignmentRationale a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "对齐理由"@zh ;
    rdfs:comment "说明 TC-SSSAO 与标准词汇之间采用 subClassOf / subPropertyOf / seeAlso 或不做正式对齐的理由。"@zh ;
    rdfs:subPropertyOf onto:alignmentRationale .

onto:attentionPcThreshold a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:comment "θ_A：运行关注碰撞概率（Pc）阈值，实验参考值 1E-7（NASA CARA 运行关注水平）"@zh ;
    rdfs:subPropertyOf onto:attentionPcThreshold .

onto:causedByEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由事件导致"@zh ;
    rdfs:comment "某事件由另一事件导致。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:causesEvent .

onto:changesOrbit a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "改变轨道"@zh ;
    rdfs:comment "空间事件改变轨道。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:Orbit .

onto:containsEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "包含事件"@zh ;
    rdfs:comment "某事件包含另一事件。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:occursDuringEvent .

onto:describesObject a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "描述目标"@zh ;
    rdfs:comment "SSA 数据描述空间目标。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range onto:SpaceObject ;
    rdfs:subPropertyOf onto:describesObject .

onto:evolvesTo a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "演化为"@zh ;
    rdfs:comment "态势状态演化为另一状态。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range onto:SituationState .

onto:generatedBy a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由……生成"@zh ;
    rdfs:comment "观测数据由观测系统生成。"@zh ;
    rdfs:domain onto:ObservationData ;
    rdfs:range onto:ObservationSystem ;
    rdfs:seeAlso prov:wasGeneratedBy ;
    owl:inverseOf onto:generatesData ;
    onto:reusedOntology prov: .

onto:generatedByActivity a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由活动生成"@zh ;
    rdfs:comment "SSA 数据由 SSA 活动生成。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range onto:SSAActivity ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    owl:inverseOf onto:producesData ;
    onto:alignmentRationale "Kept formal mapping: generatedByActivity (domain SSAData, range SSAActivity) is a sub-property of prov:wasGeneratedBy; with SSAData aligned to prov:Entity and SSAActivity to prov:Activity, the PROV generation semantics is preserved."@en .

onto:hasArgumentOfPerigee a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "近地点幅角"@zh ;
    rdfs:comment "轨道近地点幅角。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range xsd:float .

onto:hasBeginning a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有开始"@zh ;
    rdfs:comment "时间区间的开始时间点。"@zh ;
    rdfs:domain onto:TimeInterval ;
    rdfs:range onto:TimeInstant .

onto:hasCausalConfidence a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "因果置信度"@zh ;
    rdfs:comment "因果断言的可选置信度元数据。当数据来源、专家评估或外部模型提供定量置信信息时记录该值；来源未给出定量置信度时不强制赋值（M3 第一阶段起由 exactly 1 放宽为 max 1）。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range xsd:float .

onto:hasCausalMechanism a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "因果机制"@zh ;
    rdfs:comment "因果断言背后的物理或逻辑机制描述。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasCausalMechanism .

onto:hasCollisionProbability a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "碰撞概率"@zh ;
    rdfs:comment "碰撞风险概率。"@zh ;
    rdfs:domain onto:CollisionRiskEvent ;
    rdfs:range xsd:float .

onto:hasCongestionLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "拥堵等级"@zh ;
    rdfs:comment "轨道拥堵环境等级"@zh ;
    rdfs:domain onto:OrbitalCongestionEnvironment ;
    rdfs:range xsd:string .

onto:hasDataConfidence a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据置信度"@zh ;
    rdfs:comment "数据可信程度。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasDataConfidence .

onto:hasDataID a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据编号"@zh ;
    rdfs:comment "SSA 数据唯一标识。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasDataID .

onto:hasDataSource a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据来源"@zh ;
    rdfs:comment "数据来源说明。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string ;
    rdfs:seeAlso prov:wasAttributedTo ;
    rdfs:subPropertyOf onto:hasDataSource ;
    onto:reusedOntology prov: .

onto:hasDataType a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据类型"@zh ;
    rdfs:comment "数据类型说明。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasDataType .

onto:hasEncounterID a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "交会编号"@zh ;
    rdfs:comment "交会事件编号，标识同一物理交会事件的所有风险评估快照。ESA数据中对应event_id字段，同一物理交会的所有CDM共享同一event_id。B3规则使用此属性实现跨交会隔离。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range xsd:string .

onto:hasEnd a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有结束"@zh ;
    rdfs:comment "时间区间的结束时间点。"@zh ;
    rdfs:domain onto:TimeInterval ;
    rdfs:range onto:TimeInstant .

onto:hasEnvironmentLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "环境等级"@zh ;
    rdfs:comment "空间环境等级，如正常、异常、严重"@zh ;
    rdfs:domain onto:SpaceEnvironment ;
    rdfs:range xsd:string .

onto:hasEnvironmentType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "环境类型"@zh ;
    rdfs:comment "空间环境所属类型，如辐射环境、电磁环境、轨道拥堵环境等"@zh ;
    rdfs:domain onto:SpaceEnvironment ;
    rdfs:range xsd:string .

onto:hasGeometricErrorValue a rdfs:Resource,
        owl:DatatypeProperty ;
