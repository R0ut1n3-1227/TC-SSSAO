onto:hasOccurrenceTime a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "发生时间"@zh ;
    rdfs:comment "事件发生时间。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso time:hasTime ;
    rdfs:subPropertyOf onto:hasOccurrenceTime ;
    onto:reusedOntology time: .

onto:hasStartTime a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "开始时间"@zh ;
    rdfs:comment "事件开始时间。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso time:hasBeginning ;
    rdfs:subPropertyOf onto:hasStartTime ;
    onto:reusedOntology time: .

onto:indicatesThreat a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "指示威胁"@zh ;
    rdfs:comment "空间事件指示相关安全威胁"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SecurityThreat ;
    rdfs:subPropertyOf onto:indicatesThreat .

onto:mayManifestAsEvent a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "可能表现为事件"@zh ;
    rdfs:comment "安全威胁可能表现为空间事件。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:SpaceEvent ;
    rdfs:subPropertyOf onto:mayManifestAsEvent .

onto:observedBySensor a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由传感器观测"@zh ;
    rdfs:comment "观测事件由传感器观测。"@zh ;
    rdfs:domain onto:ObservationEvent ;
    rdfs:range onto:Sensor ;
    rdfs:subPropertyOf onto:observedBySensor .

onto:occursDuringEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "发生于另一事件期间"@zh ;
    rdfs:comment "某事件发生于另一事件期间。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:containsEvent .

onto:precedesEvent a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "先于事件"@zh ;
    rdfs:comment "某事件在时间上先于另一事件。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    rdfs:seeAlso time:before ;
    rdfs:subPropertyOf onto:precedesEvent ;
    owl:inverseOf onto:followsEvent ;
    onto:alignmentRationale "OWL-Time time:before relates temporal entities; TC-SSSAO precedesEvent relates SpaceEvent instances (domain events, not temporal entities). The two are at different semantic levels, so only a seeAlso reference is kept."@en .

onto:producesRisk a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "产生风险"@zh ;
    rdfs:comment "安全威胁产生安全风险。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:SecurityRisk ;
    rdfs:subPropertyOf onto:producesRisk .

onto:resultsInEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "产生事件"@zh ;
    rdfs:comment "某事件产生另一事件。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:resultedFromEvent .

onto:stateCausedByEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "状态由事件导致"@zh ;
    rdfs:comment "态势状态由事件导致。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:leadsToState .

onto:threatMitigatedBy a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "威胁被缓解"@zh ;
    rdfs:comment "安全威胁被响应措施缓解。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:ResponseMeasure ;
    rdfs:subPropertyOf onto:threatMitigatedBy .

