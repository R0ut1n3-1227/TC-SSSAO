    rdfs:range onto:SpaceObject .

onto:hasRAAN a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "升交点赤经"@zh ;
    rdfs:comment "升交点赤经（Right Ascension of Ascending Node）。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range xsd:float .

onto:hasRadiationLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "辐射水平"@zh ;
    rdfs:comment "辐射环境水平等级"@zh ;
    rdfs:domain onto:RadiationEnvironment ;
    rdfs:range xsd:string .

onto:hasResolution a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "分辨率"@zh ;
    rdfs:comment "传感器探测分辨率。"@zh ;
    rdfs:domain onto:Sensor ;
    rdfs:range xsd:float .

onto:hasRiskDescription a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "风险描述"@zh ;
    rdfs:comment "安全风险的文本描述"@zh ;
    rdfs:domain onto:SecurityRisk ;
    rdfs:range xsd:string .

onto:hasRiskLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "风险等级"@zh ;
    rdfs:comment "低、中、高、极高。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:string .

onto:hasSecondaryObject a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有次目标"@zh ;
