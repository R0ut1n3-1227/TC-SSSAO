    rdfs:domain onto:SpatialRelationEvent ;
    rdfs:range onto:SpaceObject .

onto:hasSemiMajorAxis a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "半长轴"@zh ;
    rdfs:comment "轨道半长轴。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range xsd:float .

onto:hasSize a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "尺寸"@zh ;
    rdfs:comment "空间目标的特征尺寸。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:float .

onto:hasSourceState a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有源状态"@zh ;
    rdfs:comment "状态转移的源状态。"@zh ;
    rdfs:domain onto:StateTransition ;
    rdfs:range onto:SituationState .

onto:hasSpatialRelationship a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "空间关系"@zh ;
    rdfs:comment "空间关系事件中的关系类型"@zh ;
    rdfs:domain onto:SpatialRelationEvent ;
    rdfs:range xsd:string .

onto:hasStateConfidence a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态置信度"@zh ;
    rdfs:comment "状态判断的可信程度。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:float .

onto:hasStateDescription a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态描述"@zh ;
    rdfs:comment "态势状态的文字说明。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:string .

onto:hasStateDuration a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态持续时间"@zh ;
    rdfs:comment "状态持续时间（ISO 8601 时长字符串，如 PT1H30M）。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:duration .

onto:hasStateEndTime a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态结束时间"@zh ;
    rdfs:comment "状态结束时间。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso time:hasEnd ;
    onto:reusedOntology time: .

onto:hasStateID a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态编号"@zh ;
    rdfs:comment "态势状态唯一标识。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:string .

onto:hasStateLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态等级"@zh ;
    rdfs:comment "正常、关注、异常、预警、危险、恢复等。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:string .

onto:hasStateStartTime a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态开始时间"@zh ;
    rdfs:comment "状态开始时间。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso time:hasBeginning ;
    onto:reusedOntology time: .

onto:hasStateType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "状态类型"@zh ;
    rdfs:comment "运行状态、空间安全状态、威胁状态、综合态势状态等。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:string .

onto:hasStateUpdateTime a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "态势状态更新时间"@zh ;
    rdfs:comment "态势状态最近一次更新时间。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range xsd:dateTime .

onto:hasTargetState a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有目标状态"@zh ;
    rdfs:comment "状态转移的目标状态。"@zh ;
    rdfs:domain onto:StateTransition ;
    rdfs:range onto:SituationState .

onto:hasThreatConfidence a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁置信度"@zh ;
    rdfs:comment "安全威胁评估的置信度"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:float .

onto:hasThreatID a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁编号"@zh ;
    rdfs:comment "安全威胁唯一标识。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁等级"@zh ;
    rdfs:comment "安全威胁等级"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatSource a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁来源"@zh ;
    rdfs:comment "威胁来源，如碎片、目标、环境、网络等。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁类型"@zh ;
    rdfs:comment "威胁类型，如物理、网络、电磁、环境、运行等。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:implementsMeasure a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "实施措施"@zh ;
    rdfs:comment "空间事件实施响应措施。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:ResponseMeasure ;
    owl:inverseOf onto:isImplementedByEvent .

onto:increasesThreat a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "加剧威胁"@zh ;
    rdfs:comment "空间事件加剧相关安全威胁"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SecurityThreat .

onto:isInvolvedInEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "参与事件"@zh ;
    rdfs:comment "空间目标参与空间事件。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:involvesObject .

onto:isOrbitOf a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "是某目标的轨道"@zh ;
    rdfs:comment "轨道属于空间目标。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range onto:SpaceObject ;
    owl:inverseOf onto:hasOrbit .

onto:leadsToState a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "导致状态"@zh ;
    rdfs:comment "事件导致态势状态。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SituationState ;
    owl:inverseOf onto:stateCausedByEvent .

onto:mappedToExternalTerm a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "映射到外部术语"@zh ;
    rdfs:subPropertyOf onto:mappedToExternalTerm .

onto:mitigationPcThreshold a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:comment "θ_M：高风险减缓碰撞概率（Pc）阈值，实验参考值 1E-4（NASA CARA / NPR 8079.1 减缓判据）"@zh ;
    rdfs:subPropertyOf onto:mitigationPcThreshold .

onto:modelLayer a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "模型分层"@zh ;
    rdfs:subPropertyOf onto:modelLayer .

onto:overlapsWithEvent a rdfs:Resource,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "与事件时间重叠"@zh ;
    rdfs:comment "两个事件在时间上重叠。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    rdfs:seeAlso time:intervalOverlaps ;
    onto:alignmentRationale "time:intervalOverlaps relates time intervals; TC-SSSAO overlapsWithEvent relates SpaceEvent instances with overlapping time intervals. Different semantic level: seeAlso only."@en .

onto:producesData a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "产生活动数据"@zh ;
    rdfs:comment "SSA 活动产生 SSA 数据。"@zh ;
    rdfs:domain onto:SSAActivity ;
    rdfs:range onto:SSAData ;
    owl:inverseOf onto:generatedByActivity .

onto:resultedFromEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由事件产生"@zh ;
