onto:SSAActivity a rdfs:Resource,
        owl:Class ;
    rdfs:label "空间态势感知活动"@zh ;
    rdfs:comment "支撑空间态势感知的各类活动。"@zh ;
    rdfs:subClassOf prov:Activity ;
    onto:alignmentRationale "SSAActivity covers data/knowledge processing activities (observation, tracking, prediction, conjunction assessment); it is a domain specialization of prov:Activity."@en ;
    onto:modelLayer "core"^^xsd:string .

onto:SpaceOrganization a rdfs:Resource,
        owl:Class ;
    rdfs:label "空间组织"@zh ;
    rdfs:comment "描述空间相关组织的顶层抽象类。"@zh ;
    onto:modelLayer "core"^^xsd:string .

onto:TimeInterval a rdfs:Resource,
        owl:Class ;
    rdfs:label "时间区间"@zh ;
    rdfs:comment "具有开始与结束两个端点的时间区间。"@zh ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty onto:hasEnd ;
            owl:someValuesFrom onto:TimeInstant ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty onto:hasBeginning ;
            owl:someValuesFrom onto:TimeInstant ],
        time:Interval,
        onto:TemporalEntity ;
    onto:alignmentRationale "TC-SSSAO TimeInterval is the application-domain time-interval representation, specialized from time:Interval."@en ;
    onto:modelLayer "core"^^xsd:string .

