    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasObjectID .

onto:hasOperatorName a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "运营方名称"@zh ;
    rdfs:comment "空间目标当前运营方的名称。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:string .

onto:hasOrbitalPeriod a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "轨道周期"@zh ;
