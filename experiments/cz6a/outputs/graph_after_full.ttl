onto:SpaceObject a rdfs:Resource,
        owl:Class ;
    rdfs:label "空间目标"@zh ;
    rdfs:comment "太空安全态势感知中的顶层空间目标概念，涵盖自然空间目标与人造空间目标。"@zh ;
