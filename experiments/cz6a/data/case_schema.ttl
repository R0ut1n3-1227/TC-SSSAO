@prefix case: <https://w3id.org/tc-sssao/data/cz6a-case#> .
@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CZ-6A案例局部数据模式。仅声明案例专用观测量，不修改主本体。
case:perigeeKm a owl:DatatypeProperty ; rdfs:label "近地点高度（km）"@zh ; rdfs:domain onto:Orbit ; rdfs:range xsd:float .
case:apogeeKm a owl:DatatypeProperty ; rdfs:label "远地点高度（km）"@zh ; rdfs:domain onto:Orbit ; rdfs:range xsd:float .
case:inclinationDeg a owl:DatatypeProperty ; rdfs:label "轨道倾角（deg）"@zh ; rdfs:domain onto:Orbit ; rdfs:range xsd:float .
case:semiMajorAxisKm a owl:DatatypeProperty ; rdfs:label "半长轴（km）"@zh ; rdfs:domain onto:Orbit ; rdfs:range xsd:float .
case:eccentricity a owl:DatatypeProperty ; rdfs:label "轨道偏心率"@zh ; rdfs:domain onto:Orbit ; rdfs:range xsd:float .
case:catalogedFragmentCount a owl:DatatypeProperty ; rdfs:label "编目碎片数量"@zh ; rdfs:domain onto:FragmentationEvent ; rdfs:range xsd:integer .
case:fragmentsInOrbitCount a owl:DatatypeProperty ; rdfs:label "在轨碎片数量"@zh ; rdfs:domain onto:FragmentationEvent ; rdfs:range xsd:integer .
case:assessedCause a owl:DatatypeProperty ; rdfs:label "评估原因"@zh ; rdfs:domain onto:FragmentationEvent ; rdfs:range xsd:string .
# 观测数据的报告时间。主本体 hasObservationTime 的 rdfs:domain 为 SpaceEvent，
# 直接用于 ObservationData 实例会经RDFS闭包将其误归类为 SpaceEvent 并触发R13；
# 主本体目前缺少适用于 ObservationData 的时间属性，故以案例局部属性记录（模式层局限）。
case:reportTime a owl:DatatypeProperty ; rdfs:label "观测报告时间"@zh ; rdfs:domain onto:ObservationData ; rdfs:range xsd:dateTime .
