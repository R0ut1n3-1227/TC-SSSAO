@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/tc-sssao/data/rule-scenario#Evt_Maneuver> ;
            sh:resultMessage "空间事件缺少数据证据（detectedFromData 或 supportedByData）" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "空间事件缺少数据证据（detectedFromData 或 supportedByData）"@zh ;
                    sh:select """
            PREFIX onto: <https://w3id.org/tc-sssao#>
            SELECT $this
            WHERE {
                $this a onto:SpaceEvent .
                FILTER NOT EXISTS {
                    $this onto:detectedFromData ?d .
                    ?d a onto:ObservationData .
                }
                FILTER NOT EXISTS {
                    $this onto:supportedByData ?d .
                    ?d a onto:ObservationData .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape onto:EventDataEvidenceShape ;
            sh:value <https://w3id.org/tc-sssao/data/rule-scenario#Evt_Maneuver> ] .

