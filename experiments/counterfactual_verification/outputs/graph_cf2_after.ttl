onto:hasEventType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "事件类型"@zh ;
    rdfs:comment "轨道机动、接近、碰撞风险等。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range xsd:string .

onto:hasGeometricErrorValue a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "几何误差值"@zh ;
