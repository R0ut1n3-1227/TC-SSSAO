    rdfs:comment "轨道机动事件类型"@zh ;
    rdfs:domain onto:OrbitManeuverEvent ;
    rdfs:range xsd:string .

onto:hasMass a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "质量"@zh ;
    rdfs:comment "空间目标的质量，通常以千克为单位。"@zh ;
    rdfs:domain onto:SpaceObject ;
