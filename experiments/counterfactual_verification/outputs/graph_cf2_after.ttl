onto:MultiCauseAssertion a rdfs:Resource,
        owl:Class ;
    rdfs:label "多因因果断言"@zh ;
    rdfs:comment "多个原因事件共同导致结果事件的因果断言。"@zh ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
