[] a rdfs:Resource,
        owl:AllDisjointClasses ;
    owl:members [ a rdfs:Resource ;
            rdf:first onto:RadarSensor ;
            rdf:rest [ a rdfs:Resource ;
                    rdf:first onto:OpticalSensor ;
                    rdf:rest [ a rdfs:Resource ;
                            rdf:first onto:InfraredSensor ;
                            rdf:rest () ] ] ] .

[] a rdfs:Resource,
        owl:AllDisjointClasses ;
    owl:members [ a rdfs:Resource ;
            rdf:first onto:PromotingCausalAssertion ;
            rdf:rest [ a rdfs:Resource ;
                    rdf:first onto:InhibitingCausalAssertion ;
                    rdf:rest () ] ] .

[] a rdfs:Resource,
        owl:AllDisjointClasses ;
    owl:members [ a rdfs:Resource ;
            rdf:first onto:NormalSituationState ;
            rdf:rest [ a rdfs:Resource ;
                    rdf:first onto:AttentionSituationState ;
                    rdf:rest [ a rdfs:Resource ;
                            rdf:first onto:WarningSituationState ;
                            rdf:rest [ a rdfs:Resource ;
                                    rdf:first onto:DangerousSituationState ;
                                    rdf:rest () ] ] ] ] .

[] a rdfs:Resource,
        owl:AllDisjointClasses ;
    owl:members [ a rdfs:Resource ;
            rdf:first onto:DirectCausalAssertion ;
            rdf:rest [ a rdfs:Resource ;
                    rdf:first onto:IndirectCausalAssertion ;
                    rdf:rest () ] ] .

