<https://w3id.org/tc-sssao> a rdfs:Resource,
        owl:Ontology ;
    dcterms:created "2026-07" ;
    dcterms:description "OWL 2 ontology and SHACL-SPARQL rule set for representing and reasoning over space-security situational-awareness knowledge: space objects, orbits, observation systems and data, space events, temporal relations, reified causal assertions, graded situation states, threats, risks, and response measures."@en,
        "面向太空安全态势感知知识的 OWL 2 本体与 SHACL-SPARQL 规则集，统一组织空间目标、轨道、观测系统与数据、空间事件、时序关系、实体化因果断言、分级态势状态、威胁、风险与响应措施。"@zh ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:modified "2026-09-04"^^xsd:date ;
    dcterms:title "TC-SSSAO: Temporal-Causal Space Security Situational Awareness Ontology",
        "TC-SSSAO：时序—因果太空安全态势感知本体"@zh ;
    rdfs:comment "Canonical ontology identifier. The IRI is used as the ontology identifier for this release; resolution will be configured when the public repository is published."@en,
        "规范本体标识符。当前发布包使用该 IRI 作为本体标识；解析地址将在公开仓库发布后同步配置。"@zh ;
    rdfs:seeAlso <https://w3id.org/tc-sssao/alignments> ;
    owl:versionIRI <https://w3id.org/tc-sssao/1.0.0> ;
    owl:versionInfo "1.0.0" .

