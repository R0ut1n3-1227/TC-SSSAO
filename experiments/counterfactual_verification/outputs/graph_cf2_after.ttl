    rdfs:domain onto:ResponseMeasure ;
    rdfs:range onto:SecurityThreat ;
    owl:inverseOf onto:requiresResponseMeasure .

onto:resultsInEvent a rdfs:Resource,
        owl:ObjectProperty ;
