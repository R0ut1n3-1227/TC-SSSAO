    rdfs:comment "安全威胁评估的置信度"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:float .

onto:hasThreatID a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁编号"@zh ;
    rdfs:comment "安全威胁唯一标识。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁等级"@zh ;
    rdfs:comment "安全威胁等级"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatSource a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁来源"@zh ;
    rdfs:comment "威胁来源，如碎片、目标、环境、网络等。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:hasThreatType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "威胁类型"@zh ;
    rdfs:comment "威胁类型，如物理、网络、电磁、环境、运行等。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range xsd:string .

onto:implementsMeasure a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "实施措施"@zh ;
    rdfs:comment "空间事件实施响应措施。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:ResponseMeasure ;
    owl:inverseOf onto:isImplementedByEvent .

onto:increasesThreat a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "加剧威胁"@zh ;
    rdfs:comment "空间事件加剧相关安全威胁"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SecurityThreat .

onto:indicatesThreat a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "指示威胁"@zh ;
    rdfs:comment "空间事件指示相关安全威胁"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SecurityThreat .

onto:isInvolvedInEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "参与事件"@zh ;
    rdfs:comment "空间目标参与空间事件。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:involvesObject .

onto:isOrbitOf a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "是某目标的轨道"@zh ;
    rdfs:comment "轨道属于空间目标。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range onto:SpaceObject ;
    owl:inverseOf onto:hasOrbit .

onto:mappedToExternalTerm a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "映射到外部术语"@zh ;
    rdfs:subPropertyOf onto:mappedToExternalTerm .

onto:mayManifestAsEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "可能表现为事件"@zh ;
    rdfs:comment "安全威胁可能表现为空间事件。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:SpaceEvent .

onto:mitigationPcThreshold a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:comment "θ_M：高风险减缓碰撞概率（Pc）阈值，实验参考值 1E-4（NASA CARA / NPR 8079.1 减缓判据）"@zh ;
    rdfs:subPropertyOf onto:mitigationPcThreshold .

onto:modelLayer a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "模型分层"@zh ;
    rdfs:subPropertyOf onto:modelLayer .

onto:observedBySensor a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由传感器观测"@zh ;
    rdfs:comment "观测事件由传感器观测。"@zh ;
    rdfs:domain onto:ObservationEvent ;
    rdfs:range onto:Sensor .

onto:overlapsWithEvent a rdfs:Resource,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "与事件时间重叠"@zh ;
    rdfs:comment "两个事件在时间上重叠。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    rdfs:seeAlso time:intervalOverlaps ;
    onto:alignmentRationale "time:intervalOverlaps relates time intervals; TC-SSSAO overlapsWithEvent relates SpaceEvent instances with overlapping time intervals. Different semantic level: seeAlso only."@en .

onto:producesData a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "产生活动数据"@zh ;
    rdfs:comment "SSA 活动产生 SSA 数据。"@zh ;
    rdfs:domain onto:SSAActivity ;
    rdfs:range onto:SSAData ;
    owl:inverseOf onto:generatedByActivity .

onto:producesRisk a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "产生风险"@zh ;
    rdfs:comment "安全威胁产生安全风险。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:SecurityRisk .

onto:recoversTo a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "恢复为"@zh ;
    rdfs:comment "态势状态恢复为另一状态。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range onto:SituationState ;
    rdfs:subPropertyOf onto:recoversTo .

onto:resultedFromEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由事件产生"@zh ;
    rdfs:comment "某事件由另一事件产生。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:resultsInEvent .

onto:reusedOntology a rdf:Property,
        rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "复用本体"@zh ;
    rdfs:subPropertyOf onto:reusedOntology .

onto:riskLeadsToState a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "风险导致状态"@zh ;
    rdfs:comment "安全风险导致态势状态。"@zh ;
    rdfs:domain onto:SecurityRisk ;
    rdfs:range onto:SituationState .

onto:supportedByData a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由数据支撑"@zh ;
    rdfs:comment "空间事件由 SSA 数据支撑。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SSAData ;
    rdfs:subPropertyOf onto:supportedByData .

onto:threatMitigatedBy a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "威胁被缓解"@zh ;
    rdfs:comment "安全威胁被响应措施缓解。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:ResponseMeasure .

onto:transitsFrom a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "转移自"@zh ;
    rdfs:comment "态势状态转移自另一状态。"@zh ;
    rdfs:domain onto:SituationState ;
    rdfs:range onto:SituationState ;
    owl:inverseOf onto:transitsTo .

onto:triggeredByEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由事件触发"@zh ;
    rdfs:comment "触发状态转移的空间事件。"@zh ;
    rdfs:domain onto:StateTransition ;
    rdfs:range onto:SpaceEvent .

onto:triggersEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "触发事件"@zh ;
    rdfs:comment "某事件触发另一事件发生。"@zh ;
