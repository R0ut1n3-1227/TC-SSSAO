    rdfs:subPropertyOf prov:wasGeneratedBy ;
    owl:inverseOf onto:producesData ;
    onto:alignmentRationale "Kept formal mapping: generatedByActivity (domain SSAData, range SSAActivity) is a sub-property of prov:wasGeneratedBy; with SSAData aligned to prov:Entity and SSAActivity to prov:Activity, the PROV generation semantics is preserved."@en .

onto:hasArgumentOfPerigee a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "近地点幅角"@zh ;
    rdfs:comment "轨道近地点幅角。"@zh ;
    rdfs:domain onto:Orbit ;
    rdfs:range xsd:float .

onto:hasBeginning a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有开始"@zh ;
    rdfs:comment "时间区间的开始时间点。"@zh ;
    rdfs:domain onto:TimeInterval ;
    rdfs:range onto:TimeInstant .

onto:hasCausalConfidence a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "因果置信度"@zh ;
    rdfs:comment "因果断言的可选置信度元数据。当数据来源、专家评估或外部模型提供定量置信信息时记录该值；来源未给出定量置信度时不强制赋值（M3 第一阶段起由 exactly 1 放宽为 max 1）。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range xsd:float .

onto:hasCausalEvidence a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有因果证据"@zh ;
    rdfs:comment "支撑因果断言的 SSA 数据。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range onto:SSAData ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    onto:alignmentRationale "hasCausalEvidence (domain CausalAssertion, range SSAData) states that the assertion is supported by evidence data; with CausalAssertion and SSAData both aligned to prov:Entity, this is a provenance derivation relation. It does NOT express event-level causation (causesEvent): provenance and causal relation are distinct."@en .

onto:hasCombinedHardBodyRadius a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "组合硬体半径"@zh ;
    rdfs:comment "当前交会风险评估中两个目标的组合硬体半径（combined hard-body radius），即两目标外接球半径之和；由外部交会评估给出，随评估事件变化，不作为全局部署常数。"@zh ;
    rdfs:domain onto:CollisionRiskEvent ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasCombinedHardBodyRadius .

onto:hasCongestionLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "拥堵等级"@zh ;
    rdfs:comment "轨道拥堵环境等级"@zh ;
    rdfs:domain onto:OrbitalCongestionEnvironment ;
    rdfs:range xsd:string .

onto:hasDataID a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据编号"@zh ;
    rdfs:comment "SSA 数据唯一标识。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasDataID .

onto:hasDataSource a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据来源"@zh ;
    rdfs:comment "数据来源说明。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string ;
    rdfs:seeAlso prov:wasAttributedTo ;
    rdfs:subPropertyOf onto:hasDataSource ;
    onto:reusedOntology prov: .

onto:hasDuration a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "持续时间"@zh ;
    rdfs:comment "事件持续时间（ISO 8601 时长字符串,如 PT1H30M）。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range xsd:duration ;
    rdfs:seeAlso time:hasXSDDuration ;
    onto:reusedOntology time: .

onto:hasEffect a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有结果"@zh ;
    rdfs:comment "因果断言中的结果事件。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range onto:SpaceEvent .

onto:hasEnd a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有结束"@zh ;
    rdfs:comment "时间区间的结束时间点。"@zh ;
    rdfs:domain onto:TimeInterval ;
    rdfs:range onto:TimeInstant .

onto:hasEnvironmentLevel a rdfs:Resource,
