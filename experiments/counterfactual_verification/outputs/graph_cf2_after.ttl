onto:describesObject a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "描述目标"@zh ;
    rdfs:comment "SSA 数据描述空间目标。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range onto:SpaceObject .

onto:formalExpression a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "形式化表达"@zh .

onto:hasCausalMechanism a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "因果机制"@zh ;
    rdfs:comment "因果断言背后的物理或逻辑机制描述。"@zh ;
    rdfs:domain onto:CausalAssertion ;
    rdfs:range xsd:string .

onto:hasDataConfidence a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据置信度"@zh ;
    rdfs:comment "数据可信程度。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:float .

onto:hasDataType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "数据类型"@zh ;
    rdfs:comment "数据类型说明。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range xsd:string .

onto:hasFeatureOfInterest a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有关注目标"@zh ;
    rdfs:comment "SSA 数据所关注的空间目标。"@zh ;
    rdfs:domain onto:SSAData ;
    rdfs:range onto:SpaceObject ;
    onto:alignmentRationale "Local domain property (SSAData -> SpaceObject): a data record points to its target of interest, whereas SOSA hasFeatureOfInterest relates an Observation/Actuation/Sampling ACT to its feature. Different semantic level; the former subPropertyOf sosa:hasFeatureOfInterest mapping has been removed."@en .

onto:hasLocation a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "部署位置"@zh ;
    rdfs:comment "观测系统或传感器的部署位置。"@zh ;
    rdfs:domain onto:ObservationSystem ;
    rdfs:range xsd:string .

onto:hasMeasureLevel a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施等级"@zh ;
    rdfs:comment "措施等级，如一般、重要、紧急。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
    rdfs:range xsd:string .

onto:hasMeasureType a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施类型"@zh ;
    rdfs:comment "措施类型，如规避、应急、缓解、预警等。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
    rdfs:range xsd:string .

onto:hasObservationResult a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "具有观测结果"@zh ;
    rdfs:comment "观测数据具有观测结果目标。"@zh ;
    rdfs:domain onto:ObservationData ;
    rdfs:range onto:SpaceObject ;
    onto:alignmentRationale "Local domain property (ObservationData -> SpaceObject): it links observation data to the observed space object, which is NOT the SOSA hasResult relation (Observation -> Result). The former subPropertyOf sosa:hasResult mapping has been removed; the property remains in use as a local property."@en .

onto:hasRiskValue a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "风险值"@zh ;
    rdfs:comment "由外部风险评估模型、任务系统或应用层给出的可选综合风险评分，其计算方法与取值尺度由外部系统规定，不由本体规定；承载外部评估结果，不等同于碰撞概率 hasCollisionProbability；碰撞风险态势规则（R5—R8）不再以该属性为判定条件。"@zh ;
    rdfs:domain onto:RiskEvent ;
    rdfs:range xsd:float .

onto:implementationStatus a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "实现状态"@zh .

onto:inputProperties a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "输入属性"@zh .

onto:madeBySensor a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "由传感器执行"@zh ;
    rdfs:comment "观测活动由传感器执行。"@zh ;
    rdfs:domain onto:ObservationActivity ;
    rdfs:range onto:Sensor ;
    rdfs:subPropertyOf sosa:madeBySensor ;
    onto:alignmentRationale "Kept formal mapping: madeBySensor (domain ObservationActivity, range Sensor) is a sub-property of sosa:madeBySensor; with ObservationActivity aligned to sosa:Observation and Sensor to sosa:Sensor, the SOSA Observation->Sensor semantics is preserved."@en .

onto:meetsEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "邻接事件"@zh ;
    rdfs:comment "一个事件结束时间等于另一个事件开始时间。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent .

onto:naturalLanguageRule a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "自然语言规则"@zh .

onto:occursAtTime a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "发生于时间点"@zh ;
    rdfs:comment "事件发生在某一时间点。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:TimeInstant ;
    rdfs:subPropertyOf time:hasTime ;
    onto:alignmentRationale "occursAtTime links a SpaceEvent to a TimeInstant (which is aligned with time:Instant); time:hasTime is the generic OWL-Time property connecting a resource to a temporal entity."@en .

onto:occursInTimeInterval a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "发生于时间区间"@zh ;
    rdfs:comment "事件发生在某一时间区间内。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:TimeInterval ;
    rdfs:subPropertyOf time:hasTime ;
    onto:alignmentRationale "occursInTimeInterval links a SpaceEvent to a TimeInterval (aligned with time:Interval); it is therefore a specialization of time:hasTime."@en .

onto:outputRelation a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "输出关系"@zh .

onto:ruleCategory a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "规则类别"@zh .

onto:targetClass a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "目标类"@zh .

onto:validationSeverity a rdfs:Resource,
        owl:AnnotationProperty ;
    rdfs:label "验证严重级别"@zh .

