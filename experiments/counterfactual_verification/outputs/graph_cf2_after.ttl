    rdfs:comment "事件导致态势状态。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SituationState ;
    rdfs:subPropertyOf onto:leadsToState ;
    owl:inverseOf onto:stateCausedByEvent .

onto:mitigatedBy a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "被缓解"@zh ;
    rdfs:comment "安全风险被响应措施缓解。"@zh ;
    rdfs:domain onto:SecurityRisk ;
    rdfs:range onto:ResponseMeasure ;
    owl:inverseOf onto:mitigatesRisk .

onto:mitigatesRisk a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "缓解风险"@zh ;
    rdfs:comment "响应措施缓解安全风险。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
    rdfs:range onto:SecurityRisk ;
    owl:inverseOf onto:mitigatedBy .

onto:occursDuringEvent a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "发生于另一事件期间"@zh ;
    rdfs:comment "某事件发生于另一事件期间。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    owl:inverseOf onto:containsEvent .

onto:occursInOrbit a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "发生于轨道"@zh ;
    rdfs:comment "空间事件发生于某轨道。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:Orbit .

onto:precedesEvent a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "先于事件"@zh ;
    rdfs:comment "某事件在时间上先于另一事件。"@zh ;
    rdfs:domain onto:SpaceEvent ;
    rdfs:range onto:SpaceEvent ;
    rdfs:seeAlso time:before ;
    rdfs:subPropertyOf onto:precedesEvent ;
    owl:inverseOf onto:followsEvent ;
    onto:alignmentRationale "OWL-Time time:before relates temporal entities; TC-SSSAO precedesEvent relates SpaceEvent instances (domain events, not temporal entities). The two are at different semantic levels, so only a seeAlso reference is kept."@en .

onto:requiresResponseMeasure a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "需要响应措施"@zh ;
    rdfs:comment "安全威胁需要响应措施。"@zh ;
    rdfs:domain onto:SecurityThreat ;
    rdfs:range onto:ResponseMeasure ;
    owl:inverseOf onto:respondsToThreat .

onto:respondsToEvent a rdfs:Resource,
