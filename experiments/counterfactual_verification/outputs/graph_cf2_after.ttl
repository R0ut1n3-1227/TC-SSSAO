onto:hasMeasureDescription a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施描述"@zh ;
    rdfs:comment "响应措施描述。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
