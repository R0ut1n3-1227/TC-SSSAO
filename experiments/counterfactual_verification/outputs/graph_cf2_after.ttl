onto:hasMeasureID a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "措施编号"@zh ;
    rdfs:comment "响应措施唯一标识。"@zh ;
    rdfs:domain onto:ResponseMeasure ;
