onto:hasObjectName a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "目标名称"@zh ;
    rdfs:comment "空间目标的名称。"@zh ;
    rdfs:domain onto:SpaceObject ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasObjectName .

onto:hasOperatorName a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "运营方名称"@zh ;
