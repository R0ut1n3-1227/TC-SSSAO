onto:RiskSituationRuleConfig a onto:RuleDeploymentConfiguration ;
    rdfs:comment "风险态势规则部署配置（实验示例配置）：数值由任务运行方在部署时配置，非领域常数。"@zh ;
    onto:attentionPcThreshold "1e-07"^^xsd:float ;
    onto:mitigationPcThreshold "0.0001"^^xsd:float .

onto:attentionPcThreshold a owl:DatatypeProperty ;
    rdfs:comment "θ_A：运行关注碰撞概率（Pc）阈值，实验参考值 1E-7（NASA CARA 运行关注水平）"@zh .

