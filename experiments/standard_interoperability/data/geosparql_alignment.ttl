@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .

# T4 GeoSPARQL 对齐测试数据（合成测试实例，非案例事实）
# 验证：SpaceObject⊑geo:Feature、Orbit⊑geo:Feature，以及正确的标准模式：
#   Feature — geo:hasGeometry → geo:Geometry — geo:asWKT → geo:wktLiteral
# （替代已移除的 SpaceObject/Orbit 直接 subPropertyOf geo:asWKT 捷径）。

onto:InteropSat a onto:ArtificialSpaceObject ;
    geo:hasGeometry onto:InteropGeom_Sat .

onto:InteropGeom_Sat a geo:Geometry ;
    geo:asWKT "POINT(100.0 30.0)"^^geo:wktLiteral .

onto:InteropOrbit a onto:EarthOrbit ;
    geo:hasGeometry onto:InteropGeom_Orbit .

onto:InteropGeom_Orbit a geo:Geometry ;
    geo:asWKT "LINESTRING(100.0 30.0, 101.0 31.0, 102.0 29.5)"^^geo:wktLiteral .
