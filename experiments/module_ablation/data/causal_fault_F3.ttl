@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix flt:  <https://w3id.org/tc-sssao/data/causal-fault-test#> .

#####################################################################
# M3 第二阶段：因果一致性故障注入 F3——三事件因果闭环（合成）
#
# EvtCycle1 → EvtCycle2 → EvtCycle3 → EvtCycle1（同一发生时间）
# → 主检测器 R11（CausalCycleShape，(causesEvent)+ 传递路径）。
#
# 隔离设计：
#   - 事件为 onto:SpaceEvent 直接实例，不触发 R3/R4/R5—R8/B3；
#   - 三事件使用相同 hasOccurrenceTime，避免 R9 附带触发；
#   - 无两两互指（每对节点间至多一条直接边），不触发 R10；
#   - 事件携带 detectedFromData 证据，避免 R13 附带违规。
# 本文件独立成图运行，焦点节点仅含 EvtCycle1/2/3，
# 不与 F1/F2 混入同一次检出结果。
#####################################################################

flt:FaultObsF3 a onto:RadarObservationData ;
    onto:hasDataID "FLT-OBS-F3"^^xsd:string .

flt:EvtCycle1 a onto:SpaceEvent ;
    onto:hasEventID "FLT-EVT-C1"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-06T17:10:00Z"^^xsd:dateTime ;
    onto:detectedFromData flt:FaultObsF3 ;
    onto:causesEvent flt:EvtCycle2 .

flt:EvtCycle2 a onto:SpaceEvent ;
    onto:hasEventID "FLT-EVT-C2"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-06T17:10:00Z"^^xsd:dateTime ;
    onto:detectedFromData flt:FaultObsF3 ;
    onto:causesEvent flt:EvtCycle3 .

flt:EvtCycle3 a onto:SpaceEvent ;
    onto:hasEventID "FLT-EVT-C3"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-06T17:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-06T17:10:00Z"^^xsd:dateTime ;
    onto:detectedFromData flt:FaultObsF3 ;
    onto:causesEvent flt:EvtCycle1 .
