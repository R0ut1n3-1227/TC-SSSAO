@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix ecf:  <https://w3id.org/tc-sssao/data/evidence-counterfactual#> .

#####################################################################
# M3 第二阶段：证据反事实测试数据（合成）
#
# 目的：证明 R3/R4 的证据前件不是装饰。两个场景中事件类型、对象角色、
# 时间条件全部满足，唯独缺 R3/R4 所要求的 ObservationData 证据：
#   E1：Maneuver→Approach，Approach 缺 R3 所需的 ObservationData 证据
#       → FULL 下 R3 不得生成 causesEvent；
#   E2：Approach→CollisionRisk，CollisionRisk 缺 R4 所需的 ObservationData 证据
#       → FULL 下 R4 不得生成 causesEvent。
#
# 注意：缺证据事件会被 R13（EventDataEvidenceShape）按预期标记违规，
# 这正是"数据证据缺失"在验证层的对应表现；指标只统计 causesEvent 边。
#####################################################################

# ---------- 共享对象与轨道（满足 R16 等结构约束，隔离变量）----------
# E1 与 E2 使用互不相同的交会目标对（SatX/SatY 与 SatU/SatV），
# 使两场景之间不存在类型相容的因果配对：本套件中的每一条 causesEvent
# 边都必属于 E1 或 E2 自身，指标不含跨场景附带边。
ecf:OrbitX a onto:LowEarthOrbit ;
    onto:hasOrbitType "LEO"^^xsd:string .

ecf:OrbitY a onto:LowEarthOrbit ;
    onto:hasOrbitType "LEO"^^xsd:string .

ecf:OrbitU a onto:LowEarthOrbit ;
    onto:hasOrbitType "LEO"^^xsd:string .

ecf:OrbitV a onto:LowEarthOrbit ;
    onto:hasOrbitType "LEO"^^xsd:string .

ecf:SatX a onto:Spacecraft ;
    onto:hasObjectID "ECF-SAT-X"^^xsd:string ;
    onto:hasOrbit ecf:OrbitX .

ecf:SatY a onto:Spacecraft ;
    onto:hasObjectID "ECF-SAT-Y"^^xsd:string ;
    onto:hasOrbit ecf:OrbitY .

ecf:SatU a onto:Spacecraft ;
    onto:hasObjectID "ECF-SAT-U"^^xsd:string ;
    onto:hasOrbit ecf:OrbitU .

ecf:SatV a onto:Spacecraft ;
    onto:hasObjectID "ECF-SAT-V"^^xsd:string ;
    onto:hasOrbit ecf:OrbitV .

ecf:E1_Obs a onto:RadarObservationData ;
    onto:hasDataID "ECF-DATA-E1"^^xsd:string .

ecf:E2_Obs a onto:RadarObservationData ;
    onto:hasDataID "ECF-DATA-E2"^^xsd:string .

# ---------- E1：Approach 缺观测证据 ----------
ecf:E1_Maneuver a onto:OrbitManeuverEvent ;
    onto:hasEventID "ECF-E1-MAN"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-07T09:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-07T09:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-07T09:10:00Z"^^xsd:dateTime ;
    onto:affectsObject ecf:SatX ;
    onto:involvesObject ecf:SatX ;
    onto:detectedFromData ecf:E1_Obs .

ecf:E1_Approach a onto:ApproachEvent ;
    onto:hasEventID "ECF-E1-APP"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-07T10:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-07T10:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-07T10:20:00Z"^^xsd:dateTime ;
    onto:hasPrimaryObject ecf:SatX ;
    onto:hasSecondaryObject ecf:SatY ;
    onto:involvesObject ecf:SatX , ecf:SatY .
    # 故意缺失：detectedFromData / supportedByData

# ---------- E2：CollisionRisk 缺 R4 所需的 ObservationData 证据（独立目标对 SatU/SatV）----------
ecf:E2_Approach a onto:ApproachEvent ;
    onto:hasEventID "ECF-E2-APP"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-07T11:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-07T11:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-07T11:20:00Z"^^xsd:dateTime ;
    onto:hasPrimaryObject ecf:SatU ;
    onto:hasSecondaryObject ecf:SatV ;
    onto:involvesObject ecf:SatU , ecf:SatV ;
    onto:detectedFromData ecf:E2_Obs .

ecf:E2_Risk a onto:CollisionRiskEvent ;
    onto:hasEventID "ECF-E2-CRK"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-07T12:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-07T12:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-07T12:30:00Z"^^xsd:dateTime ;
    onto:hasPrimaryObject ecf:SatU ;
    onto:hasSecondaryObject ecf:SatV ;
    onto:involvesObject ecf:SatU , ecf:SatV ;
    onto:hasCollisionProbability "5.0E-6"^^xsd:float ;
    onto:hasPredictedMissDistance "0.300"^^xsd:float ;
    onto:hasCombinedHardBodyRadius "0.010"^^xsd:float .
    # 故意缺失：detectedFromData / supportedByData
