@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://w3id.org/tc-sssao#> .
@prefix flt:  <https://w3id.org/tc-sssao/data/causal-fault-test#> .

#####################################################################
# M3 第二阶段：因果一致性故障注入 F1——时间逆序因果（合成）
#
# 晚事件 causesEvent 早事件 → 主检测器 R9（CauseBeforeEffectShape）。
# 本文件独立成图运行，不与 F2/F3 混入同一次检出结果。
#
# 隔离设计：
#   - 事件为 onto:SpaceEvent 直接实例，不触发 R3/R4/R5—R8/B3；
#   - 仅单向 causesEvent（无互指、无回路），不触发 R10/R11；
#   - 事件携带 detectedFromData 证据，避免 R13 附带违规；
#     时间条件 start ≤ occurrence ≤ end，避免附带违规。
#####################################################################

flt:FaultObsF1 a onto:RadarObservationData ;
    onto:hasDataID "FLT-OBS-F1"^^xsd:string .

flt:EvtEarly a onto:SpaceEvent ;
    onto:hasEventID "FLT-EVT-EARLY"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-06T14:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-06T14:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-06T14:10:00Z"^^xsd:dateTime ;
    onto:detectedFromData flt:FaultObsF1 .

flt:EvtLate a onto:SpaceEvent ;
    onto:hasEventID "FLT-EVT-LATE"^^xsd:string ;
    onto:hasOccurrenceTime "2026-08-06T15:00:00Z"^^xsd:dateTime ;
    onto:hasStartTime "2026-08-06T15:00:00Z"^^xsd:dateTime ;
    onto:hasEndTime "2026-08-06T15:10:00Z"^^xsd:dateTime ;
    onto:detectedFromData flt:FaultObsF1 ;
    onto:causesEvent flt:EvtEarly .
