<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:onto="https://w3id.org/tc-sssao#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasImpactScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">影响范围</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:comment xml:lang="zh">威胁影响范围，如目标、轨道区域、任务系统等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nebac7b07aab647009e617ae6d641a30c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasThreatID"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCongestionLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#OrbitalCongestionEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">拥堵等级</rdfs:label>
    <rdfs:comment xml:lang="zh">轨道拥堵环境等级</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasPrimaryObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有主目标</rdfs:label>
    <rdfs:comment xml:lang="zh">空间关系事件中交会对象对的主要目标，用于显式表示目标角色。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#evolvesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">演化为</rdfs:label>
    <rdfs:comment xml:lang="zh">态势状态演化为另一状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#requiresResponseMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">需要响应措施</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁需要响应措施。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#respondsToThreat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">态势状态唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#CollisionRiskEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">碰撞风险事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标之间存在碰撞风险的事件。作为空间关系事件，通过 hasPrimaryObject/hasSecondaryObject 显式表示交会目标角色。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RiskEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpatialRelationEvent"/>
    <rdfs:subClassOf rdf:nodeID="Nc87be26ad07b4c769c23bfc90293d3f1"/>
    <rdfs:subClassOf rdf:nodeID="Na5aab7cf7e1345afab597db5f5d1b6ff"/>
    <rdfs:subClassOf rdf:nodeID="N64035a8fc82d40758871c4771bb19ee5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#AvoidanceMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">规避措施</rdfs:label>
    <rdfs:comment xml:lang="zh">通过规避动作降低威胁或风险的措施。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#Spacecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">航天器</rdfs:label>
    <rdfs:comment xml:lang="zh">具备特定任务功能、可在轨运行或深空飞行的人造空间飞行器。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ArtificialSpaceObject"/>
    <rdfs:subClassOf rdf:nodeID="Ndec8ac58bf7c4429982cb45446154703"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2e9743f71fc649d88b53de09daee6101">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#RadarSensor"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#GroundRadarSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">地基雷达传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">部署于地面的雷达传感器。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#GroundBasedSensor"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#RadarSensor"/>
    <owl:equivalentClass rdf:nodeID="N1d173ece8bea4be5bf3ed62d6d29833d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#WarningSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">预警态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势达到预警级别。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="N4c0a990101e043c8bc0bb3cc26f6d723"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#DangerousSituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataSource">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据来源</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">数据来源说明。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#naturalLanguageRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">自然语言规则</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有结果</rdfs:label>
    <rdfs:comment xml:lang="zh">因果断言中的结果事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasDataID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">数据编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:comment xml:lang="zh">SSA 数据唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#AttentionSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">关注态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势需要关注。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="N40c2047549ad4b89b7e34822dfb9a938"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#WarningSituationState"/>
    <owl:disjointWith rdf:resource="https://w3id.org/tc-sssao#DangerousSituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateEndTime">
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/2006/time#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态结束时间</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">状态结束时间。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEnvironmentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">环境类型</rdfs:label>
    <rdfs:comment xml:lang="zh">空间环境所属类型，如辐射环境、电磁环境、轨道拥堵环境等</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpatialRelationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间关系事件</rdfs:label>
    <rdfs:comment xml:lang="zh">描述多个空间目标之间空间关系的事件。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:subClassOf rdf:nodeID="Nc7a116ab6a0e4d699ba5885088b1a879"/>
    <rdfs:subClassOf rdf:nodeID="N65af3e52ba14409faa8a57f03ce166b0"/>
    <rdfs:subClassOf rdf:nodeID="N6c426fc8ecae45d68f2343e05b39eb13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeasureID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">措施编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:comment xml:lang="zh">响应措施唯一标识。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#MultiCauseAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">多因因果断言</rdfs:label>
    <rdfs:comment xml:lang="zh">多个原因事件共同导致结果事件的因果断言。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:subClassOf rdf:nodeID="Nbc4609f50bcf49f89cf7ff334d5a4773"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#ArtificialSpaceObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">人造空间目标</rdfs:label>
    <rdfs:comment xml:lang="zh">由人类制造并发射至外层空间的目标。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:subClassOf rdf:nodeID="N598f8d154ba34822a2a6436f4cbe8d2b"/>
    <rdfs:subClassOf rdf:nodeID="Nd1d2774da57b43f189ac8f197b6973ee"/>
    <rdfs:subClassOf rdf:nodeID="N564f7ec7c0ac457baf3970644765ea29"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasStateType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">状态类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">运行状态、空间安全状态、威胁状态、综合态势状态等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SpaceEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间事件</rdfs:label>
    <rdfs:comment xml:lang="zh">描述引起态势变化的空间事件。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:nodeID="N06314a18fb9e4da89493be8e07d54914"/>
    <rdfs:subClassOf rdf:nodeID="Nd4a75465101f43b6a273a6c8ff4fdce7"/>
    <rdfs:subClassOf rdf:nodeID="N3b9a0cc64ed14d4eb709e1764ad6f756"/>
