  <rdf:Description rdf:about="https://w3id.org/tc-sssao#PhysicalThreat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">物理威胁</rdfs:label>
    <rdfs:comment xml:lang="zh">由物理接近或碰撞等物理作用导致的威胁。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#occursAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">发生于时间点</rdfs:label>
    <rdfs:comment xml:lang="zh">事件发生在某一时间点。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#TimeInstant"/>
    <onto:alignmentRationale xml:lang="en">occursAtTime links a SpaceEvent to a TimeInstant (which is aligned with time:Instant); time:hasTime is the generic OWL-Time property connecting a resource to a temporal entity.</onto:alignmentRationale>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N564f7ec7c0ac457baf3970644765ea29">
