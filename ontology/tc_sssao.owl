    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasCongestionLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8b4ef06d12174915a02f4e777f544d7c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#triggersState"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSourceState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有源状态</rdfs:label>
    <rdfs:comment xml:lang="zh">状态转移的源状态。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCausalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有因果证据</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑因果断言的 SSA 数据。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <onto:alignmentRationale xml:lang="en">hasCausalEvidence (domain CausalAssertion, range SSAData) states that the assertion is supported by evidence data; with CausalAssertion and SSAData both aligned to prov:Entity, this is a provenance derivation relation. It does NOT express event-level causation (causesEvent): provenance and causal relation are distinct.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#triggeredByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由事件触发</rdfs:label>
    <rdfs:comment xml:lang="zh">触发状态转移的空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3e1cb0684c4c462992f50fb0143c4acc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasGeometricErrorValue"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd3e5f0787c6b4e08a60685d42e7eca2d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOrbit"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4b2e8aa1b7b8417c98d991a3ca549901">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#resultsInEvent"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd1d2774da57b43f189ac8f197b6973ee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasLaunchCountry"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasEncounterID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">交会编号</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:comment xml:lang="zh">交会事件编号，标识同一物理交会事件的所有风险评估快照。ESA数据中对应event_id字段，同一物理交会的所有CDM共享同一event_id。B3规则使用此属性实现跨交会隔离。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncdb8a7c603694e58a514056a7d1f7157">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#occursDuringEvent"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na44333435de44416bd88b9cd110303b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#producesRisk"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#isInvolvedInEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">参与事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标参与空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceObject"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#involvesObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N552a7ac8371f4552aa1c5d9496b09f1a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasErrorValue"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N89f016bded04407e9ef5615ae708f989">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#triggersEvent"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#OrbitManeuverEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">轨道机动事件</rdfs:label>
    <rdfs:comment xml:lang="zh">空间目标改变轨道的机动事件。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#OrbitalEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObjectBehaviorEvent"/>
    <rdfs:subClassOf rdf:nodeID="Na0ac38ce25854793b8aba65ad85eaeea"/>
    <rdfs:subClassOf rdf:nodeID="N9726f0aa679b45fc970d23d13c088129"/>
    <rdfs:subClassOf rdf:nodeID="N1cc641089ebe400c877dd68ab75a67ef"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeanAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">平近点角</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Orbit"/>
    <rdfs:comment xml:lang="zh">轨道平近点角。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#outputRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">输出关系</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">具有原因</rdfs:label>
    <rdfs:comment xml:lang="zh">因果断言中的原因事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CausalAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasCombinedHardBodyRadius">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">组合硬体半径</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#CollisionRiskEvent"/>
    <rdfs:comment xml:lang="zh">当前交会风险评估中两个目标的组合硬体半径（combined hard-body radius），即两目标外接球半径之和；由外部交会评估给出，随评估事件变化，不作为全局部署常数。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">太空态势感知数据</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑因果断言与事件判断的太空态势感知数据。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <onto:alignmentRationale xml:lang="en">SSAData is information that is produced, used, cited and traced; all data subclasses (ObservationData, AssessmentData, PredictionData, RiskAssessmentData, TrackingData, ...) thereby become prov:Entity.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nae42b51f671244258d09cbc9c3b3924c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#triggeredByEvent"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N40c2047549ad4b89b7e34822dfb9a938">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9a731c1b78ce492aaf15d0d1c9eafbf8">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#AttentionSituationState"/>
    <rdf:rest rdf:nodeID="N1aab83d41f334ecca4459b9697f31b08"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SurveillanceSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">监视系统</rdfs:label>
    <rdfs:comment xml:lang="zh">用于监视空间区域的系统。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extension</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#ObservationSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRadiationLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#RadiationEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">辐射水平</rdfs:label>
    <rdfs:comment xml:lang="zh">辐射环境水平等级</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb3afa5bbd9c490f94a919424bf2e35c">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#GroundBasedSensor"/>
    <rdf:rest rdf:nodeID="N2e9743f71fc649d88b53de09daee6101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#DangerousSituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">危险态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">整体态势处于危险级别。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:subClassOf rdf:nodeID="Nc86c9ca5c6d3457ab20297202d4119f8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbdde30e1cfa6462e90f12a277bd019e6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSourceState"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#reusedOntology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">复用本体</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasGeometricErrorValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">几何误差值</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#GeometricConstruct"/>
    <rdfs:comment xml:lang="zh">几何构造的误差值。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N974aa82fc6c54f91bce6c74a39700fa5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasOrbitalPeriod"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd38015caca4740449adaadc337256b51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasStateLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne86c82bc52ba4486bd6a0a8b2c09b506">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#mitigatesRisk"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#SecurityRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">威胁来源</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:comment xml:lang="zh">威胁来源，如碎片、目标、环境、网络等。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMissionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">任务类型</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#Spacecraft"/>
    <rdfs:comment xml:lang="zh">航天器承担的任务类型。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasMeasureLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">措施等级</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:comment xml:lang="zh">措施等级，如一般、重要、紧急。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SSAActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">空间态势感知活动</rdfs:label>
    <rdfs:comment xml:lang="zh">支撑空间态势感知的各类活动。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <onto:alignmentRationale xml:lang="en">SSAActivity covers data/knowledge processing activities (observation, tracking, prediction, conjunction assessment); it is a domain specialization of prov:Activity.</onto:alignmentRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd812fd5aefbe4af6a784fcdfd380f256">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasCause"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N863dfee0578c4935b545ebc05cec5671">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#mitigatedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#InfraredSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">红外传感器</rdfs:label>
    <rdfs:comment xml:lang="zh">以红外为主要感知机制的传感器。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5ed86607c254488a9c4f629056718f24">
    <rdf:first rdf:resource="https://w3id.org/tc-sssao#OpticalSensor"/>
    <rdf:rest rdf:nodeID="Nedb397f271444d85bd91aeefb42e3861"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc86c9ca5c6d3457ab20297202d4119f8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSeverityRank"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#validationSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="zh">验证严重级别</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#respondsToEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">响应事件</rdfs:label>
    <rdfs:comment xml:lang="zh">响应措施响应空间事件。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ResponseMeasure"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N370750040aaa4bb681932d41d0ff6e02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasEffect"/>
