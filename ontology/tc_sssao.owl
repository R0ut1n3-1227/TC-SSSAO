  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#SituationState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">态势状态</rdfs:label>
    <rdfs:comment xml:lang="zh">描述某一阶段的安全态势。</rdfs:comment>
    <onto:modelLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core</onto:modelLayer>
    <rdfs:subClassOf rdf:nodeID="Ne898e12c4ec2458aa22b3310538abfe5"/>
    <rdfs:subClassOf rdf:nodeID="Nd38015caca4740449adaadc337256b51"/>
    <rdfs:subClassOf rdf:nodeID="N14df74aab582497996f92a0f8ae011a1"/>
    <rdfs:subClassOf rdf:nodeID="N2bfd54da5ba44b4091bb03db7e7cf0e8"/>
    <rdfs:subClassOf rdf:nodeID="N501be36c74f84df9b49d0041cf02d484"/>
    <rdfs:subClassOf rdf:nodeID="N6a01b426661741adad93556abd5a8917"/>
    <rdfs:subClassOf rdf:nodeID="N00da46593b1c4d2ca585858bc56d258a"/>
    <rdfs:subClassOf rdf:nodeID="N3fa5a2b6ed8e4927b18ef7d4dd11fe8b"/>
    <rdfs:subClassOf rdf:nodeID="N49645661aef347f7a18f38af4dce94ab"/>
    <rdfs:subClassOf rdf:nodeID="N8fe18ffcc4cd4580b75d68f0b5c826c0"/>
