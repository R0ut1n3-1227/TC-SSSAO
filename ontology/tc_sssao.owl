    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <onto:reusedOntology rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#detectedFromData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由数据发现</rdfs:label>
    <rdfs:comment xml:lang="zh">空间事件由 SSA 数据发现。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SpaceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasThreatLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SecurityThreat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="zh">威胁等级</rdfs:label>
    <rdfs:comment xml:lang="zh">安全威胁等级</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6b8e9a3618a640c1b0af869a2979f348">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasSize"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1bae477298b340369e7322a8bb7b5225">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tc-sssao#hasRadiationLevel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasRiskLevel">
