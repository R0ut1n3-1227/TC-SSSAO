  <rdf:Description rdf:about="https://w3id.org/tc-sssao#producesData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">产生活动数据</rdfs:label>
    <rdfs:comment xml:lang="zh">SSA 活动产生 SSA 数据。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SSAActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#SSAData"/>
    <owl:inverseOf rdf:resource="https://w3id.org/tc-sssao#generatedByActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#observedBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">由传感器观测</rdfs:label>
    <rdfs:comment xml:lang="zh">观测事件由传感器观测。</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#ObservationEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/tc-sssao#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tc-sssao#hasSeverityRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">严重度级别</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="https://w3id.org/tc-sssao#SituationState"/>
    <rdfs:comment xml:lang="zh">分级风险态势的严重度排序值：正常=0、关注=1、预警=2、危险=3；仅用于支持分级态势之间的排序及跨时间演化规则。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N55d218d93a734561ad5c1c006334011c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
